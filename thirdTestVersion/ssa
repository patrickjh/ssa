#!/bin/sh
# ssa — third test version. One script, or -a for the loop.
# Help is design.txt. Flags are -v, -y, -m, and -a.

set -u

# Users can set
SSA_KEY="${SSA_KEY:-}"
SSA_LIMIT="${SSA_LIMIT:-400000}"
SSA_LOGS="${SSA_LOGS:-${TMPDIR:-/tmp}}"
SSA_MODEL="${SSA_MODEL:-}"
SSA_PORT="${SSA_PORT:-}"
SSA_URL="${SSA_URL:-}"
SSA_VERBOSE="${SSA_VERBOSE:-0}"
SSA_WAIT="${SSA_WAIT:-120}"
SSA_YES="${SSA_YES:-0}"

# Internal
AGENT_MODE=0
CURL_RESPONSE=""
JQ_BINARY_FLAG=""
LOG_FILE=""
LOOP_STATUS=""
MENU=""
PID=$$
REPLY=""
REQUEST_MODEL=""
SCRIPT_OUTPUT=""
SCRIPT_RAW=""
SCRIPT_STATUS=0
SERVER_PID=""
SERVER_PORT=""
SERVER_URL=""
STDIN_TEXT=""
TASK=""
UPDATED_LOG=""

SYSTEM_TEXT='A user is asking you to use POSIX sh to help with a task.
Your response may be sent directly to sh -c so reply with a script only.
Put reasoning in # comments.
No markdown fences.
If the task is ambiguous,
pick the usual form and name the assumption in a # comment.
Write files using quoted heredocs to avoid issues.'

AGENT_MODE_TEXT='You can work on the task over multiple turns.
After a script runs, the next user message is the
output and the exit code. Write the next script
from that.
When the task is done, make # complete the last
line of the script. The run ends when that script
exits 0.'

EDIT_NOTE='ssa-edit is available as a CLI command on this machine.
ssa-edit applies one search/replace block to edit a file.
The argument is the file path. The search/replace block is on stdin.
Use a quoted heredoc. The file must already exist.
The search block must be non-empty and match once.

ssa-edit hello.txt <<"EOF"
<<<<<<< SEARCH
hello
=======
hello
world
>>>>>>> REPLACE
EOF'

# Pin messages 0 and 1 (system, first user). Drop the oldest
# assistant/user pair while content length is over budget and a
# pair remains after the newest one. Budget 0 sends every turn.
CONTEXT_WINDOW_JQ='
def nbytes: map(.content | length) | add // 0;
def drop_pair: .[0:2] + .[4:];
def over: nbytes > $budget;
def droppable: length > 4 and .[1].role != .[4].role;
(.messages
  | if $budget == 0 then .
    else until((over | not) or (droppable | not); drop_pair)
    end) as $kept
| $extra + {model: $model, messages: $kept}
'

main() {
    trap 'stop_server; exit 1' USR1
    trap 'stop_server; exit 129' HUP
    trap 'stop_server; exit 130' INT
    trap 'stop_server; exit 143' TERM
    read_command_line "$@"
    check_can_run
    read_standard_input
    choose_model
    setup_run
    run_turns
    finish_run
}

read_command_line() {
    while [ $# -gt 0 ]; do
        case $1 in
            -a) AGENT_MODE=1 ;;
            -v) SSA_VERBOSE=1 ;;
            -y) SSA_YES=1 ;;
            -m)
                shift
                [ -n "${1:-}" ] || die "-m needs a model; see design.txt"
                SSA_MODEL=$1
                ;;
            --) shift; break ;;
            -*) die "unknown flag $1; see design.txt" ;;
            *) break ;;
        esac
        shift
    done
    TASK="$*"
}

check_can_run() {
    check_task
    check_commands
    check_number "$SSA_LIMIT" "SSA_LIMIT"
    check_number "$SSA_WAIT" "SSA_WAIT"
    check_zero_or_one "$SSA_VERBOSE" "SSA_VERBOSE"
    check_zero_or_one "$SSA_YES" "SSA_YES"
    check_log_folder
    check_model_is_set
}

check_task() {
    [ -n "$TASK" ] || die "task not found on the CLI; see design.txt"
}

check_commands() {
    for COMMAND in curl date jq sed tr uname
    do
        command -v "$COMMAND" >/dev/null 2>&1 ||
            die "$COMMAND not found on PATH"
    done
}

check_number() {
    case $1 in
        ''|*[!0-9]*) die "invalid $2; see design.txt" ;;
    esac
}

check_zero_or_one() {
    case $1 in
        0|1) ;;
        *) die "invalid $2; see design.txt" ;;
    esac
}

check_log_folder() {
    if [ ! -d "$SSA_LOGS" ] || [ ! -w "$SSA_LOGS" ]; then
        die "SSA_LOGS must be a writable directory; see design.txt"
    fi
}

check_model_is_set() {
    [ -n "$SSA_MODEL" ] || die "SSA_MODEL not set; see design.txt"
}

read_standard_input() {
    STDIN_TEXT=""
    if [ -t 0 ]; then
        return
    fi
    STDIN_TEXT=$(tr -d '\000') || die "cannot read stdin"
}

choose_model() {
    if [ -f "$SSA_MODEL" ]; then
        use_local_model
    else
        use_cloud_model
    fi
}

use_local_model() {
    check_local_commands
    choose_port
    start_server
    REQUEST_MODEL=local
    SSA_URL="${SERVER_URL}/v1/chat/completions"
}

check_local_commands() {
    for COMMAND in llama-server sleep
    do
        command -v "$COMMAND" >/dev/null 2>&1 ||
            die "$COMMAND not found on PATH"
    done
}

choose_port() {
    if [ -n "$SSA_PORT" ]; then
        use_requested_port
    else
        pick_free_port
    fi
}

use_requested_port() {
    check_port_number
    SERVER_PORT=$SSA_PORT
    SERVER_URL="http://127.0.0.1:${SERVER_PORT}"
    if server_answers; then
        die "SSA_PORT is in use; see design.txt"
    fi
}

check_port_number() {
    case $SSA_PORT in
        *[!0-9]*) die "invalid SSA_PORT; see design.txt" ;;
    esac
    if [ "$SSA_PORT" -lt 1 ] || [ "$SSA_PORT" -gt 65535 ]; then
        die "invalid SSA_PORT; see design.txt"
    fi
}

pick_free_port() {
    TRY=0
    BASE=$((20000 + PID % 10000))
    while [ "$TRY" -lt 10 ]; do
        SERVER_PORT=$((BASE + TRY))
        SERVER_URL="http://127.0.0.1:${SERVER_PORT}"
        if ! server_answers; then
            return
        fi
        TRY=$((TRY + 1))
    done
    die "no free port; see design.txt"
}

start_server() {
    verbose "model file: $SSA_MODEL"
    verbose "server: $SERVER_URL"
    if [ "$SSA_VERBOSE" = 1 ]; then
        launch_server >&2
    else
        launch_server >/dev/null 2>&1
    fi
    SERVER_PID=$!
    wait_for_server
}

launch_server() {
    llama-server \
        --model "$SSA_MODEL" \
        --alias local \
        --host 127.0.0.1 \
        --port "$SERVER_PORT" &
}

wait_for_server() {
    COUNT=0
    while :; do
        if ! kill -0 "$SERVER_PID" 2>/dev/null; then
            die "llama-server exited"
        fi
        if server_answers; then
            verbose "server is up"
            return
        fi
        if [ "$COUNT" -ge "$SSA_WAIT" ]; then
            die "llama-server did not answer in $SSA_WAIT seconds"
        fi
        COUNT=$((COUNT + 1))
        sleep 1
    done
}

server_answers() {
    curl -sf -o /dev/null --max-time 2 "$SERVER_URL/health"
}

use_cloud_model() {
    [ -n "$SSA_URL" ] || die "SSA_URL not set; see design.txt"
    REQUEST_MODEL=$SSA_MODEL
}

setup_run() {
    setup_jq_binary_flag
    setup_log
    log_settings
    verbose "start: $REQUEST_MODEL at $SSA_URL"
    verbose "log file: $LOG_FILE"
    setup_messages
}

setup_jq_binary_flag() {
    # Some jq builds write CRLF unless -b (binary stdout) is set.
    # jq 1.6 and older lack -b, so only use it when it works.
    JQ_BINARY_FLAG=""
    if jq -b -n '""' >/dev/null 2>&1; then
        JQ_BINARY_FLAG="-b"
    fi
}

setup_log() {
    START_TIME=$(date '+%Y-%m-%d_%H.%M.%S')
    LOG_FILE="${SSA_LOGS}/${START_TIME}.${PID}.json"
    # shellcheck disable=SC2086
    ( umask 077; set -C
      jq $JQ_BINARY_FLAG -n \
          --arg time "$START_TIME" \
          --arg directory "$(pwd)" \
          --arg url "$SSA_URL" \
          --arg task "$TASK" \
          '{time:$time, directory:$directory, url:$url, task:$task,
            context:"", status:"running", settings:"",
            messages:[], turns:[]}' >"$LOG_FILE" ) || {
        rm -f "$LOG_FILE"
        LOG_FILE=""
        die "cannot write log"
    }
}

log_settings() {
    save_log --arg settings "$(printf '%s\n' \
        "AGENT_MODE=$AGENT_MODE" \
        "SSA_LIMIT=$SSA_LIMIT" \
        "SSA_LOGS=$SSA_LOGS" \
        "SSA_MODEL=$SSA_MODEL" \
        "SSA_PORT=$SERVER_PORT" \
        "SSA_URL=$SSA_URL" \
        "SSA_VERBOSE=$SSA_VERBOSE" \
        "SSA_WAIT=$SSA_WAIT" \
        "SSA_YES=$SSA_YES")" \
        '.settings = $settings'
}

setup_messages() {
    # shellcheck disable=SC2086
    UPDATED_LOG=$(build_system_prompt |
        jq $JQ_BINARY_FLAG -Rs \
            --arg user "$(build_context)" \
            --slurpfile log "$LOG_FILE" \
            '. as $text | $log[0]
             | .context = $user
             | .messages = [
                 {role:"system", content:$text},
                 {role:"user", content:$user}]') ||
        die "cannot write chat messages"
    commit_log || die "cannot write chat messages"
}

build_system_prompt() {
    printf '%s\n\n' "$SYSTEM_TEXT"
    if [ "$AGENT_MODE" = 1 ]; then
        printf '%s\n\n' "$AGENT_MODE_TEXT"
    fi
    printf 'The task for this run:\n%s' "$TASK"
}

build_context() {
    OS_NAME=$(uname -srm 2>/dev/null) || OS_NAME="unknown"
    printf 'Operating system: %s\nDirectory: %s\n' "$OS_NAME" "$(pwd)"
    if command -v ssa-edit >/dev/null 2>&1; then
        printf '\n%s\n' "$EDIT_NOTE"
    fi
    if [ -n "$STDIN_TEXT" ]; then
        printf '\n%s\n' "$STDIN_TEXT"
    fi
}

run_turns() {
    while :; do
        read_model_reply
        if [ "$AGENT_MODE" = 1 ] && reply_is_only_complete; then
            LOOP_STATUS=done
            return
        fi
        if [ "$AGENT_MODE" = 1 ] && ! reply_is_valid_shell; then
            tell_invalid_script
            continue
        fi
        apply_menu
        if [ "$LOOP_STATUS" = done ] || [ "$LOOP_STATUS" = quit ]; then
            return
        fi
    done
}

read_model_reply() {
    call_model
    append_assistant_turn
    REPLY=$(print_reply)
}

call_model() {
    begin_model_turn
    send_request
    save_model_turn
}

begin_model_turn() {
    # shellcheck disable=SC2086
    save_log \
        --arg model "$REQUEST_MODEL" \
        --argjson budget "$SSA_LIMIT" \
        --argjson extra "{}" \
        "($CONTEXT_WINDOW_JQ)"' as $body
          | .turns += [{request:$body, response:"", reply:"",
                        output:"", exit_code:null}]'
}

send_request() {
    verbose "curl $SSA_URL"
    if [ -n "$SSA_KEY" ]; then
        CURL_RESPONSE=$(post_curl -H "Authorization: Bearer $SSA_KEY") ||
            die "curl failed; see design.txt"
    else
        CURL_RESPONSE=$(post_curl) || die "curl failed; see design.txt"
    fi
}

post_curl() {
    # shellcheck disable=SC2086
    jq $JQ_BINARY_FLAG -cj '.turns[-1].request' "$LOG_FILE" |
        curl -sS --fail \
            --retry 4 --retry-connrefused --retry-max-time 120 \
            --connect-timeout 30 \
            -H "Content-Type: application/json" \
            "$@" \
            --data-binary @- \
            "$SSA_URL"
}

save_model_turn() {
    # shellcheck disable=SC2086
    if printf '%s' "$CURL_RESPONSE" | jq $JQ_BINARY_FLAG -e \
        '.choices[0].message.content | type == "string"' \
        >/dev/null 2>&1
    then
        UPDATED_LOG=$(printf '%s' "$CURL_RESPONSE" |
            jq $JQ_BINARY_FLAG -Rs --slurpfile log "$LOG_FILE" \
                '. as $raw | ($raw | fromjson) as $parsed | $log[0]
                 | .turns[-1].response = $raw
                 | .turns[-1].reply =
                     $parsed.choices[0].message.content') ||
            die "cannot update log"
        commit_log || die "cannot update log"
        return
    fi
    UPDATED_LOG=$(printf '%s' "$CURL_RESPONSE" |
        jq $JQ_BINARY_FLAG -Rs --slurpfile log "$LOG_FILE" \
            '. as $raw | $log[0]
             | .turns[-1].response = $raw
             | .turns[-1].reply = ""') || UPDATED_LOG=""
    if [ -n "$UPDATED_LOG" ]; then
        commit_log || :
    fi
    die "invalid chat response; see design.txt"
}

append_assistant_turn() {
    save_log '.messages += [{role:"assistant", content:.turns[-1].reply}]'
}

save_log() {
    try_save_log "$@" || die "cannot update log"
}

print_reply() {
    # shellcheck disable=SC2086
    jq $JQ_BINARY_FLAG -rj '.turns[-1].reply' "$LOG_FILE"
}

reply_is_only_complete() {
    [ "$(printf '%s\n' "$REPLY" | sed '/^[[:space:]]*$/d')" = "# complete" ]
}

reply_is_valid_shell() {
    printf '%s\n' "$REPLY" | sh -n >/dev/null 2>&1
}

tell_invalid_script() {
    printf '%s\n\n%s\n' "model generated an invalid script, trying again" \
        "$REPLY"
    append_user_text "invalid script"
}

apply_menu() {
    choose_menu
    case $MENU in
        yes) run_chosen_script ;;
        feedback) read_feedback ;;
        quit) LOOP_STATUS=quit ;;
    esac
}

choose_menu() {
    show_reply
    if [ "$SSA_YES" = 1 ]; then
        MENU=yes
    else
        ask_menu
    fi
}

show_reply() {
    if [ "$SSA_YES" = 1 ]; then
        printf '%s\n' "$REPLY"
        return
    fi
    printf '%s\n' "$REPLY" >/dev/tty ||
        die "need /dev/tty or set SSA_YES=1; see design.txt"
}

ask_menu() {
    read_menu_answer
    case $ANSWER in
        y|Y) MENU=yes ;;
        f|F) MENU=feedback ;;
        q|Q) MENU=quit ;;
        *)
            printf '%s\n' 'answer only Y F or Q' >/dev/tty ||
                die "need /dev/tty or set SSA_YES=1; see design.txt"
            ask_menu
            ;;
    esac
}

read_menu_answer() {
    printf 'Run this script? [Y]es [F]eedback [Q]uit ' >/dev/tty ||
        die "need /dev/tty or set SSA_YES=1; see design.txt"
    IFS= read -r ANSWER </dev/tty ||
        die "need /dev/tty or set SSA_YES=1; see design.txt"
}

read_feedback() {
    printf 'feedback: ' >/dev/tty ||
        die "need /dev/tty or set SSA_YES=1; see design.txt"
    IFS= read -r ANSWER </dev/tty ||
        die "need /dev/tty or set SSA_YES=1; see design.txt"
    if [ -z "$ANSWER" ]; then
        ANSWER="The user sent no text."
    fi
    append_user_text "$ANSWER"
}

run_chosen_script() {
    if [ "$AGENT_MODE" = 1 ]; then
        run_agent_script
        if [ "$SCRIPT_STATUS" -eq 0 ] && reply_ends_with_complete; then
            LOOP_STATUS=done
        fi
        return
    fi
    run_user_script
    LOOP_STATUS=done
}

run_agent_script() {
    SCRIPT_RAW=$(
        sh -c "$REPLY" </dev/null 2>&1
        status=$?
        printf '\n.'
        exit "$status"
    )
    SCRIPT_STATUS=$?
    keep_script_output
    printf '%s' "$SCRIPT_OUTPUT"
    append_run_result
}

keep_script_output() {
    # $( ) drops a trailing newline, so the capture ends with a dot.
    SCRIPT_OUTPUT=${SCRIPT_RAW%.}
    NL=$(printf '\n.')
    NL=${NL%.}
    SCRIPT_OUTPUT=${SCRIPT_OUTPUT%"$NL"}
    SCRIPT_RAW=$(printf '%s.' "$SCRIPT_OUTPUT" | tr -d '\000')
    SCRIPT_OUTPUT=${SCRIPT_RAW%.}
    save_turn_output
}

save_turn_output() {
    # shellcheck disable=SC2086
    UPDATED_LOG=$(printf '%s' "$SCRIPT_OUTPUT" |
        jq $JQ_BINARY_FLAG -Rs \
            --argjson code "$SCRIPT_STATUS" \
            --slurpfile log "$LOG_FILE" \
            '. as $raw | $log[0]
             | .turns[-1].output = $raw
             | .turns[-1].exit_code = $code') ||
        die "cannot update log"
    commit_log || die "cannot update log"
}

append_run_result() {
    if output_is_json_safe; then
        append_user_text "$(printf '%s\n\n%s\n%s' \
            "Output from running the script:" \
            "$SCRIPT_OUTPUT" \
            "Script exit code: ${SCRIPT_STATUS}")"
    else
        append_user_text "$(printf '%s\n\n%s' \
            "Output omitted: not valid UTF-8 (binary bytes)." \
            "Script exit code: ${SCRIPT_STATUS}")"
    fi
}

output_is_json_safe() {
    # shellcheck disable=SC2086
    printf '%s' "$SCRIPT_OUTPUT" | jq $JQ_BINARY_FLAG -e -Rs \
        'contains("\u0000") | not' >/dev/null 2>&1
}

append_user_text() {
    # shellcheck disable=SC2086
    UPDATED_LOG=$(printf '%s' "$1" |
        jq $JQ_BINARY_FLAG -Rs --slurpfile log "$LOG_FILE" \
            '. as $text | $log[0]
             | .messages += [{role:"user", content:$text}]') ||
        die "cannot update log"
    commit_log || die "cannot update log"
}

die() {
    printf '%s\n' "$*" >&2
    set_log_status "die: $*"
    if [ "$$" -eq "$PID" ]; then
        stop_server
    fi
    kill -USR1 "$PID" 2>/dev/null || :
    exit 1
}

reply_ends_with_complete() {
    [ "$(printf '%s\n' "$REPLY" | sed '/^[[:space:]]*$/d' | \
        sed -n '$p')" = "# complete" ]
}

run_user_script() {
    if ( exec </dev/tty ) 2>/dev/null; then
        sh -c "$REPLY" </dev/tty
    else
        sh -c "$REPLY" </dev/null
    fi
    SCRIPT_STATUS=$?
}

finish_run() {
    if [ -z "$LOOP_STATUS" ]; then
        LOOP_STATUS=done
    fi
    set_log_status "$LOOP_STATUS"
    stop_server
    if [ "$AGENT_MODE" = 0 ] && [ "$MENU" = yes ]; then
        exit "$SCRIPT_STATUS"
    fi
    exit 0
}

set_log_status() {
    if [ -z "${LOG_FILE:-}" ] || [ ! -f "$LOG_FILE" ]; then
        return 0
    fi
    try_save_log --arg status "$1" '.status = $status' || return 0
}

try_save_log() {
    # shellcheck disable=SC2086
    UPDATED_LOG=$(jq $JQ_BINARY_FLAG "$@" "$LOG_FILE") || return 1
    commit_log
}

commit_log() {
    printf '%s\n' "$UPDATED_LOG" >"$LOG_FILE" || return 1
}

stop_server() {
    if [ -z "$SERVER_PID" ]; then
        return
    fi
    verbose "stop server"
    kill "$SERVER_PID" 2>/dev/null || :
    wait "$SERVER_PID" 2>/dev/null || :
    SERVER_PID=""
}

verbose() {
    if [ "$SSA_VERBOSE" = 0 ]; then
        return
    fi
    printf 'ssa: %s\n' "$*" >&2
}

main "$@"
