#!/bin/sh
# ssa-local — run ssa against a local llama-server.
# Help is README.md. This program has no -h or --help.

set -u

# Users can set
SSA_MODEL_FILE="${SSA_MODEL_FILE:-}"
SSA_SERVER_PORT="${SSA_SERVER_PORT:-8080}"
SSA_SERVER_WAIT="${SSA_SERVER_WAIT:-120}"

# Internal
COUNT=0
SERVER_PID=""
SERVER_URL="http://127.0.0.1:${SSA_SERVER_PORT}"
TASK=""

main() {
    trap 'stop_server; exit 129' HUP
    trap 'stop_server; exit 130' INT
    trap 'stop_server; exit 143' TERM
    TASK="$*"
    check_can_run
    start_server
    run_ssa
    STATUS=$?
    stop_server
    exit "$STATUS"
}

check_can_run() {
    check_task
    check_commands
    check_model_file
    check_server_port
    check_server_wait
    check_port_is_free
}

check_task() {
    [ -n "$TASK" ] || die "task not found on CLI; see README.md"
}

check_commands() {
    for COMMAND in curl llama-server sleep ssa
    do
        command -v "$COMMAND" >/dev/null 2>&1 ||
            die "$COMMAND not found on PATH"
    done
}

check_model_file() {
    [ -n "$SSA_MODEL_FILE" ] || die "SSA_MODEL_FILE not set; see README.md"
    [ -f "$SSA_MODEL_FILE" ] ||
        die "model file not found: $SSA_MODEL_FILE"
}

check_server_port() {
    case $SSA_SERVER_PORT in
        ''|*[!0-9]*)
            die "SSA_SERVER_PORT must be a number; see README.md" ;;
    esac
    if [ "$SSA_SERVER_PORT" -lt 1 ] || [ "$SSA_SERVER_PORT" -gt 65535 ]
    then
        die "SSA_SERVER_PORT must be 1 to 65535; see README.md"
    fi
}

check_server_wait() {
    case $SSA_SERVER_WAIT in
        ''|*[!0-9]*)
            die "SSA_SERVER_WAIT must be a number; see README.md" ;;
    esac
}

check_port_is_free() {
    if server_answers; then
        die "SSA_SERVER_PORT is in use; see README.md"
    fi
}

start_server() {
    # The four flags below are not settings. ssa is told the same
    # address and the same model name, so these must match it.
    # Server output goes to stderr, which keeps stdout for the loop.
    llama-server \
        --model "$SSA_MODEL_FILE" \
        --alias local \
        --host 127.0.0.1 \
        --port "$SSA_SERVER_PORT" \
        >&2 &
    SERVER_PID=$!
    wait_for_server
}

wait_for_server() {
    COUNT=0
    while :; do
        if ! kill -0 "$SERVER_PID" 2>/dev/null; then
            die "llama-server exited"
        fi
        if server_answers; then
            return 0
        fi
        if [ "$COUNT" -ge "$SSA_SERVER_WAIT" ]; then
            die "llama-server did not answer in $SSA_SERVER_WAIT seconds"
        fi
        COUNT=$((COUNT + 1))
        sleep 1
    done
}

server_answers() {
    curl -sf -o /dev/null --max-time 2 "$SERVER_URL/health"
}

run_ssa() {
    # A small local model does best with one reply shape. These
    # four are off by default; set one to 0 to turn it back on.
    SSA_NO_EDITS="${SSA_NO_EDITS:-1}" \
    SSA_NO_MESSAGES="${SSA_NO_MESSAGES:-1}" \
    SSA_NO_QUESTIONS="${SSA_NO_QUESTIONS:-1}" \
    SSA_NO_WRITES="${SSA_NO_WRITES:-1}" \
    SSA_MODEL=local \
    SSA_URL="${SERVER_URL}/v1/chat/completions" \
        ssa "$TASK"
}

stop_server() {
    if [ -z "$SERVER_PID" ]; then
        return
    fi
    kill "$SERVER_PID" 2>/dev/null || :
    wait "$SERVER_PID" 2>/dev/null || :
    SERVER_PID=""
}

die() {
    printf '%s\n' "$*" >&2
    stop_server
    exit 1
}

main "$@"
