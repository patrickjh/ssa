#!/bin/sh
# ssa-ask — show a question and print the user's line.
# Help is README.md. The question is read from stdin.

set -u

# Internal
ANSWER=""
QUESTION=""

main() {
    read_command_line "$@"
    check_commands
    read_question
    check_question
    show_question
    read_answer
    print_answer
}

read_command_line() {
    if [ $# -ne 0 ]; then
        die "question is on stdin; see README.md"
    fi
}

check_commands() {
    for COMMAND in cat grep sed
    do
        command -v "$COMMAND" >/dev/null 2>&1 ||
            die "$COMMAND not on PATH"
    done
}

read_question() {
    QUESTION=$(cat) || die "cannot read question"
}

check_question() {
    if printf '%s\n' "$QUESTION" | grep -q '[^[:space:]]'; then
        return
    fi
    die "the question was empty"
}

show_question() {
    printf 'ssa-ask:\n' >/dev/tty || die "need /dev/tty; see README.md"
    printf '%s\n' "$QUESTION" | sanitize_output >/dev/tty ||
        die "cannot show question"
    printf 'your reply: ' >/dev/tty ||
        die "need /dev/tty; see README.md"
}

read_answer() {
    IFS= read -r ANSWER </dev/tty || die "need /dev/tty; see README.md"
}

print_answer() {
    if [ -z "$ANSWER" ]; then
        printf '%s\n' 'The user sent no text.'
        return
    fi
    printf '%s\n' "$ANSWER"
}

sanitize_output() {
    # Carriage return can overwrite the line; show as \r.
    CR_AS_SLASH_R="s/$(printf '\r')/\\\\r/g"
    # ESC starts ANSI/CSI sequences; show as \e.
    ESC_AS_SLASH_E="s/$(printf '\033')/\\\\e/g"
    # Other non-print bytes (keep tab); show as ?.
    NONPRINT_AS_QUESTION="s/[^[:print:]$(printf '\t')]/?/g"
    sed -e "$CR_AS_SLASH_R" |
        sed -e "$ESC_AS_SLASH_E" |
        sed -e "$NONPRINT_AS_QUESTION"
}

die() {
    printf '%s\n' "$*" >&2
    exit 1
}

main "$@"
