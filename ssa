#!/bin/sh
# ssa — Simple Shell Agent. One POSIX sh file.
# Help is README.md. This program has no -h or --help.

set -u

# Users can set
SSA_EXTRA_SYSTEM_TEXT="${SSA_EXTRA_SYSTEM_TEXT:-}"
SSA_LLAMA_CLI_ARGS="${SSA_LLAMA_CLI_ARGS:-}"
SSA_LOG_FOLDER="${SSA_LOG_FOLDER:-${TMPDIR:-/tmp}}"
SSA_NO_ASK="${SSA_NO_ASK:-0}"
SSA_NO_EDITS="${SSA_NO_EDITS:-0}"
SSA_NO_SCRIPTS="${SSA_NO_SCRIPTS:-0}"
SSA_NO_WRITES="${SSA_NO_WRITES:-0}"
SSA_VERBOSE="${SSA_VERBOSE:-0}"

# Harness flags first. The caller's flags follow.
SSA_LLAMA_CLI_ARGS="--reasoning off \
--reasoning-budget 0 \
--simple-io \
--no-display-prompt \
--no-show-timings \
--color off \
--context-shift \
--keep -1 \
${SSA_LLAMA_CLI_ARGS}"

# Internal
ACTION_EXIT_CODE=""
CHUNK_END=0
CHUNK_START=0
FILE_TO_EDIT=""
FILE_TO_WRITE=""
LOG_FILE=""
OUTPUT_END=0
OUTPUT_START=0
PID=$$
PROMPT_COUNTER=0
REPLY=""
REPLY_END=0
REPLY_START=0
SYSTEM_PROMPT=""
TASK=""
USER_REJECTION_REASON=""

SYSTEM_PROMPT_INTRO='You help users solve tasks with your replies. The
task for this run is at the end of this system prompt. Later turns are
prior commands and their output. Continue from there with exactly one
of the reply formats below.
No markdown fences, no thinking tags. Put reasoning in # comments.
End every reply with a line that is exactly # end.
Put nothing after that line.'

REPLY_SPEC_HEAD='These are the valid reply formats:'

REPLY_SPEC_SCRIPT=\
'A script request is "# script" then a POSIX sh program. Each script
is a new process. The program ends before the # end line. Do not
prefix script lines with #. A body line must not be exactly # end.
Example:

# reasoning: look at the files in the folder
# script
ls -la
# end'

REPLY_SPEC_WRITE=\
'A write request is "# write file: PATH" then raw file contents.
The contents end before the # end line. A body line must not be
exactly # end. A write does not create parent directories. Prefer
this over POSIX tools for writing files because this has no quoting
issues. Example:

# reasoning: write a hello.txt file
# write file: hello.txt
hello
world
# end'

REPLY_SPEC_EDIT=\
'An edit request is "# edit file: PATH" then one SEARCH/REPLACE. The search
block must match exactly once. The next line is # end. A body line
must not be exactly # end. A search or replace line must not be
exactly ======= or >>>>>>> REPLACE. Prefer this for edits over sed
and other POSIX tools because this has no quoting issues. Example:

# reasoning: edit the hello.txt file
# edit file: hello.txt
<<<<<<< SEARCH
hello
=======
hello
world
>>>>>>> REPLACE
# end'

REPLY_SPEC_COMPLETE=\
'The task complete marker is "# complete" in its own turn.
Do not append it to other turns. Example:

# complete
# end'

EDIT_FILE_AWK='
function fail(message) {
    print message | "cat >&2"
    close("cat >&2")
    fail_called = 1
    exit 1
}

function load_file(line, size, seen) {
    edit_path = ENVIRON["FILE_TO_EDIT"]
    size = ENVIRON["FILE_SIZE"] + 0
    file_text = ""
    while ((getline line < edit_path) > 0) {
        if (seen) file_text = file_text "\n"
        file_text = file_text line
        seen = 1
    }
    close(edit_path)
    if (!seen) return
    if (length(file_text) + 1 == size)
        file_text = file_text "\n"
    else if (length(file_text) != size)
        fail("cannot read file")
}

function count_search_matches(count, pos, at) {
    if (search_block == "") fail("search block is empty")
    count = 0
    pos = 1
    while (1) {
        at = index(substr(file_text, pos), search_block)
        if (at == 0) return count
        count++
        pos = pos + at + length(search_block) - 1
    }
}

function apply_edit(edit_location, before, after) {
    edit_location = index(file_text, search_block)
    before = substr(file_text, 1, edit_location - 1)
    after = substr(file_text, edit_location + length(search_block))
    printf("%s", before replace_block after) > edit_path
    if (close(edit_path) != 0) fail("cannot write file")
}

replace_lines == 1 {
    if ($0 == "# end" || $0 ~ /^[[:space:]]*$/) next
    fail("bad format: text after the replace marker")
}

/^# edit file: ./ {
    if (edit_lines != 0 || search_lines != 0 ||
        mid_lines != 0 || replace_lines != 0)
        fail("bad format: too many or misplaced edit line")
    edit_lines++
    edit_at = NR
}

/^<<<<<<< SEARCH$/ {
    if (edit_lines != 1 || search_lines != 0 ||
        mid_lines != 0 || replace_lines != 0 ||
        NR != edit_at + 1)
        fail("bad format: too many or misplaced search marker")
    search_lines++
}

/^=======$/ {
    if (edit_lines != 1 || search_lines != 1 ||
        mid_lines != 0 || replace_lines != 0)
        fail("bad format: too many or misplaced middle marker")
    mid_lines++
}

/^>>>>>>> REPLACE$/ {
    if (edit_lines != 1 || search_lines != 1 ||
        mid_lines != 1 || replace_lines != 0)
        fail("bad format: too many or misplaced replace marker")
    replace_lines++
}

/^<<<<<<< SEARCH$/,/^=======$/ {
    if ($0 != "<<<<<<< SEARCH" && $0 != "=======") {
        if (search_started) search_block = search_block "\n"
        search_block = search_block $0
        search_started = 1
        if ($0 != "") search_nonblank = 1
    }
}

/^=======$/,/^>>>>>>> REPLACE$/ {
    if ($0 != "=======" && $0 != ">>>>>>> REPLACE") {
        if (replace_started) replace_block = replace_block "\n"
        replace_block = replace_block $0
        replace_started = 1
        if ($0 != "") replace_nonblank = 1
    }
}

END {
    if (fail_called) exit 1
    if (replace_lines != 1)
        fail("bad format: missing replace marker")
    if (!search_started) fail("search block is empty")
    if (search_started && !search_nonblank)
        search_block = search_block "\n"
    if (replace_started && !replace_nonblank)
        replace_block = replace_block "\n"
    load_file()
    count = count_search_matches()
    if (count != 1)
        fail("search block matched " count " times (need 1)")
    apply_edit()
}
'

main() {
    trap 'exit 1' USR1
    trap 'die "llama-cli exited; see README.md"' PIPE
    TASK="$*"
    check_posix_commands
    check_llama
    check_can_run
    setup_agent_loop
    run_agent_loop
    finish_agent_loop
}

check_posix_commands() {
    check_command awk
    check_command cat
    check_command date
    check_command grep
    check_command head
    check_command mkfifo
    check_command rm
    check_command sed
    check_command tr
    check_command wc
}

check_command() {
    command -v "$1" >/dev/null 2>&1 || die "$1 not found on PATH"
}

check_llama() {
    if command -v llama-cli >/dev/null 2>&1; then
        return
    fi
    command -v llama >/dev/null 2>&1 ||
        die "llama-cli or llama not found on PATH"
    llama cli --version >/dev/null 2>&1 ||
        die "llama cli --version failed"
}

check_can_run() {
    check_task
    check_no_ask
    check_no_edits
    check_no_scripts
    check_no_writes
    check_verbose
    check_some_action_left
    check_log_folder
    check_llama_cli_args
    check_tty
}

check_task() {
    [ -n "$TASK" ] || die "task not found on CLI; see README.md"
}

check_no_ask() {
    if [ "$SSA_NO_ASK" != 0 ] && [ "$SSA_NO_ASK" != 1 ]; then
        die "SSA_NO_ASK must be 0 or 1; see README.md"
    fi
}

check_no_edits() {
    if [ "$SSA_NO_EDITS" != 0 ] && [ "$SSA_NO_EDITS" != 1 ]; then
        die "SSA_NO_EDITS must be 0 or 1; see README.md"
    fi
}

check_no_scripts() {
    if [ "$SSA_NO_SCRIPTS" != 0 ] && [ "$SSA_NO_SCRIPTS" != 1 ]; then
        die "SSA_NO_SCRIPTS must be 0 or 1; see README.md"
    fi
}

check_no_writes() {
    if [ "$SSA_NO_WRITES" != 0 ] && [ "$SSA_NO_WRITES" != 1 ]; then
        die "SSA_NO_WRITES must be 0 or 1; see README.md"
    fi
}

check_verbose() {
    if [ "$SSA_VERBOSE" != 0 ] && [ "$SSA_VERBOSE" != 1 ]; then
        die "SSA_VERBOSE must be 0 or 1; see README.md"
    fi
}

check_some_action_left() {
    if [ "$SSA_NO_SCRIPTS" = 1 ] && [ "$SSA_NO_WRITES" = 1 ] &&
        [ "$SSA_NO_EDITS" = 1 ]
    then
        die "SSA_NO_SCRIPTS, SSA_NO_WRITES, and SSA_NO_EDITS" \
            "are all 1; see README.md"
    fi
}

check_log_folder() {
    if [ ! -d "$SSA_LOG_FOLDER" ] || [ ! -w "$SSA_LOG_FOLDER" ]; then
        die "SSA_LOG_FOLDER must be a writable directory; see README.md"
    fi
}

check_llama_cli_args() {
    printf '%s\n' "$SSA_LLAMA_CLI_ARGS" |
        grep -q -E \
            '(^|[[:space:]])(-m|--model)[[:space:]]+[^[:space:]]' ||
        die "SSA_LLAMA_CLI_ARGS needs -m or --model; see README.md"
}

check_tty() {
    if [ "$SSA_NO_ASK" != 0 ]; then return; fi
    ( exec <>/dev/tty ) 2>/dev/null ||
        die "need /dev/tty or set SSA_NO_ASK=1; see README.md"
}

setup_agent_loop() {
    setup_log
    setup_system_prompt
    start_llama
}

setup_log() {
    LOG_FILE="${SSA_LOG_FOLDER}/$(date '+%Y-%m-%d_%H.%M.%S').${PID}.ssalog"
    ( umask 077; set -C; : >"$LOG_FILE" ) || {
        LOG_FILE=""
        die "cannot create log file"
    }
    if [ "$SSA_VERBOSE" = 1 ]; then
        printf 'log file: %s\n' "$LOG_FILE"
    fi
}

setup_system_prompt() {
    SYSTEM_PROMPT=$(
        printf '%s\n\n' "$SYSTEM_PROMPT_INTRO"
        print_reply_specs
        if [ -n "$SSA_EXTRA_SYSTEM_TEXT" ]; then
            printf '\n%s\n' "$SSA_EXTRA_SYSTEM_TEXT"
        fi
        printf '\n%s\n%s\n' 'The task for this run:' "$TASK"
    )
    begin_log_chunk "# system"
    printf '%s\n' "$SYSTEM_PROMPT" >>"$LOG_FILE" ||
        die "cannot append log"
    end_log_chunk
}

print_reply_specs() {
    printf '%s' "$REPLY_SPEC_HEAD"
    if [ "$SSA_NO_SCRIPTS" = 0 ]; then
        printf '\n\n%s' "$REPLY_SPEC_SCRIPT"
    fi
    if [ "$SSA_NO_WRITES" = 0 ]; then
        printf '\n\n%s' "$REPLY_SPEC_WRITE"
    fi
    if [ "$SSA_NO_EDITS" = 0 ]; then
        printf '\n\n%s' "$REPLY_SPEC_EDIT"
    fi
    printf '\n\n%s\n' "$REPLY_SPEC_COMPLETE"
}

start_llama() {
    # Progress uses stdout. At 0, drop it before
    # llama-cli starts so load text goes there too.
    if [ "$SSA_VERBOSE" = 0 ]; then
        exec >/dev/null || die "cannot open /dev/null"
    fi
    create_fifos
    watch_llama &
    # Stays open until this process exits. That close
    # is what tells the watcher to kill llama-cli.
    exec 5>"$(llama_fifo_path lifeline)" ||
        die "cannot open llama lifeline"
    # Stdout, then stdin. Each open unblocks the
    # matching llama-cli redirect.
    exec 4<"$(llama_fifo_path output)" ||
        die "cannot open llama-cli output"
    exec 3>"$(llama_fifo_path input)" ||
        die "cannot open llama-cli input"
    clean_up_fifos
}

create_fifos() {
    if ! ( umask 077; mkfifo "$(llama_fifo_path lifeline)" ); then
        die "cannot create lifeline fifo"
    fi
    if ! ( umask 077; mkfifo "$(llama_fifo_path input)" ); then
        die "cannot create input fifo"
    fi
    if ! ( umask 077; mkfifo "$(llama_fifo_path output)" ); then
        die "cannot create output fifo"
    fi
}

watch_llama() {
    exec 5<"$(llama_fifo_path lifeline)" || exit 1
    trap '' HUP INT TERM PIPE
    set -f
    umask 077
    # shellcheck disable=SC2086
    exec_llama \
        -sys "$SYSTEM_PROMPT" \
        $SSA_LLAMA_CLI_ARGS \
        --reverse-prompt '
# end
' \
        2>&1 \
        >"$(llama_fifo_path output)" \
        <"$(llama_fifo_path input)" &
    LLAMA_PID=$!
    cat <&5 >/dev/null
    kill -KILL "$LLAMA_PID" 2>/dev/null || :
    wait "$LLAMA_PID" 2>/dev/null || :
    clean_up_fifos
}

exec_llama() {
    if command -v llama-cli >/dev/null 2>&1; then
        exec llama-cli "$@"
    else
        exec llama cli "$@"
    fi
}

run_agent_loop() {
    log_stdin_context
    while :; do
        PROMPT_COUNTER=$((PROMPT_COUNTER + 1))
        call_llama
        handle_model_response
        case $? in
            2) break ;;
            0) continue ;;
            *) die "unknown loop status $?" ;;
        esac
    done
}

log_stdin_context() {
    begin_log_chunk "# sent to model"
    append_log '%s\n' 'Context from stdin (may be blank):'
    if [ ! -t 0 ]; then
        tr -d '\000' >>"$LOG_FILE" ||
            die "cannot append log"
        printf '\n' >>"$LOG_FILE" ||
            die "cannot append log"
    fi
    end_log_chunk
}

call_llama() {
    print_log_slice "$CHUNK_START" "$CHUNK_END" |
        send_user_message
    USER_REJECTION_REASON=""
    ACTION_EXIT_CODE=""
    log_llama_output
    REPLY_START=$CHUNK_START
    REPLY_END=$CHUNK_END
}

send_user_message() {
    while IFS= read -r LINE || [ -n "$LINE" ]; do
        printf '%s\\\n' "$LINE" >&3 ||
            die "llama-cli exited; see README.md"
    done || die "cannot read user message"
    printf '\n' >&3 ||
        die "llama-cli exited; see README.md"
}

log_llama_output() {
    begin_log_chunk "# llama-cli output"
    while :; do
        IFS= read -r LLAMA_LINE <&4 ||
            die "llama-cli exited; see README.md"
        printf '%s\n' "$LLAMA_LINE" >>"$LOG_FILE" ||
            die "cannot append log"
        printf '%s\n' "$LLAMA_LINE" | sanitize_output ||
            die "cannot show model reply"
        if [ "$LLAMA_LINE" = '# end' ]; then
            break
        fi
    done
    end_log_chunk
}

handle_model_response() {
    if ! print_log_slice "$REPLY_START" "$REPLY_END" |
        grep -q '[^[:space:]]'
    then
        record_format_error "the reply was empty"
    elif ! reply_has_end_marker; then
        record_format_error "the reply had no # end line"
    elif [ "$(first_action_line)" = '# complete' ]; then
        return 2
    elif action_path_is_missing; then
        record_format_error "the path is missing"
    elif first_action_line | grep -q '^# write file: .'; then
        handle_write_request
    elif first_action_line | grep -q '^# edit file: .'; then
        handle_edit_request
    elif first_action_line | grep -q '^# script$'; then
        handle_script_request
    else
        record_format_error "the reply had no action line"
    fi
    return 0
}

reply_has_end_marker() {
    print_log_slice "$REPLY_START" "$REPLY_END" | grep -qxF '# end'
}

action_path_is_missing() {
    first_action_line | grep -q -E '^# (write|edit) file:[[:space:]]*$'
}

handle_write_request() {
    if ! [ "$SSA_NO_WRITES" = 0 ]; then
        record_format_error "# write file: is not allowed"
        return
    fi
    ask_to_run_action || return
    FILE_TO_WRITE=$(first_action_line | sed 's/^# write file: //')
    apply_write_request
}

handle_edit_request() {
    if ! [ "$SSA_NO_EDITS" = 0 ]; then
        record_format_error "# edit file: is not allowed"
    elif edit_body_has_repeated_marker_line '======='; then
        record_format_error \
            "a search or replace line must not be exactly ======="
    elif edit_body_has_repeated_marker_line '>>>>>>> REPLACE'; then
        record_format_error \
            "a search or replace line must not be exactly >>>>>>> REPLACE"
    elif ask_to_run_action; then
        FILE_TO_EDIT=$(first_action_line | sed 's/^# edit file: //')
        apply_edit_request
    fi
}

edit_body_has_repeated_marker_line() {
    [ "$(
        print_action_body '^# edit file: .' |
            grep -cxF -- "$1"
    )" -gt 1 ]
}

handle_script_request() {
    if ! [ "$SSA_NO_SCRIPTS" = 0 ]; then
        record_format_error "# script is not allowed"
    elif ! script_payload | grep -q '[^[:space:]]'; then
        record_format_error "the script was empty"
    elif print_log_slice "$REPLY_START" "$REPLY_END" | grep -q '^```'; then
        record_format_error "the reply used a markdown fence"
    elif reply_has_thinking_tags; then
        record_format_error "the reply used a thinking tag"
    elif ! script_payload | sh -n >/dev/null 2>&1; then
        record_format_error "sh -n failed"
    elif ask_to_run_action; then
        run_script
    fi
}

reply_has_thinking_tags() {
    print_log_slice "$REPLY_START" "$REPLY_END" |
        grep -qF -e '<think>' -e '</think>' -e '<|channel>thought'
}

record_format_error() {
    printf '%s\n' "$*"
    begin_log_chunk "# sent to model"
    append_log '%s\n' "$*"
    end_log_chunk
}

ask_to_run_action() {
    if [ "$SSA_NO_ASK" = 0 ]; then
        ask_user_to_approve_action || {
            record_action_rejection
            return 1
        }
    fi
    return 0
}

apply_write_request() {
    begin_action_message
    if ! {
        print_action_body '^# write file: .' \
            >"$FILE_TO_WRITE" &&
            printf 'wrote file: %s\n' "$FILE_TO_WRITE"
        ACTION_EXIT_CODE=$?
    } >>"$LOG_FILE" 2>&1
    then
        die "cannot append log"
    fi
    printf '\n' >>"$LOG_FILE" || die "cannot append log"
    finish_action_message "$ACTION_EXIT_CODE"
}

apply_edit_request() {
    if [ ! -f "$FILE_TO_EDIT" ]; then
        record_edit_failure "$FILE_TO_EDIT" "file not found"
        return
    fi
    if file_contains_nul "$FILE_TO_EDIT"; then
        record_edit_failure "$FILE_TO_EDIT" "file contains a NUL"
        return
    fi
    if ! ERR=$(
        print_log_slice "$REPLY_START" "$REPLY_END" |
            FILE_TO_EDIT="$FILE_TO_EDIT" \
            FILE_SIZE="$(wc -c <"$FILE_TO_EDIT" |
                tr -d '[:space:]')" \
            LC_ALL=C awk "$EDIT_FILE_AWK" 2>&1
    ); then
        [ -n "$ERR" ] || die "cannot apply edit"
        record_edit_failure "$FILE_TO_EDIT" "$ERR"
        return
    fi
    record_output_line "$(printf 'edited file: %s' "$FILE_TO_EDIT")" 0
}

record_edit_failure() {
    record_output_line \
        "$(printf 'edit failed: %s: %s' "$1" "$2")" 1
}

first_action_line() {
    # llama-cli can glue its > prompt to the
    # first line, with or without a space.
    print_log_slice "$REPLY_START" "$REPLY_END" |
        grep -E '^>? ?# (complete$|write file:|edit file:|script$)' |
        head -n 1 |
        sed -e 's/^>//' -e 's/^ //' |
        grep .
}

ask_user_to_approve_action() {
    print_model_reply
    handle_user_answers
}

print_model_reply() {
    printf 'ssa action:\n' >/dev/tty ||
        die "need /dev/tty or set SSA_NO_ASK=1; see README.md"
    print_log_slice "$REPLY_START" "$REPLY_END" |
        sanitize_output >/dev/tty ||
        die "cannot show model reply"
}

handle_user_answers() {
    while true; do
        printf '\nApply this action? [Y]es / [N]o / [Q]uit ' >/dev/tty ||
            die "need /dev/tty or set SSA_NO_ASK=1; see README.md"
        read_ask_answer_from_tty
        case $(printf '%s\n' "$REPLY" |
            tr '[:upper:]' '[:lower:]') in
            y|yes) return 0 ;;
            n|no) return 1 ;;
            q|quit) die "User chose to quit." ;;
            *) print_invalid_input ;;
        esac
    done
}

read_ask_answer_from_tty() {
    IFS= read -r REPLY </dev/tty ||
        die "need /dev/tty or set SSA_NO_ASK=1; see README.md"
    begin_log_chunk "# apply this action? user answer"
    printf '%s\n' "$REPLY" >>"$LOG_FILE" || die "cannot append log"
    end_log_chunk
}

print_invalid_input() {
    printf 'invalid input: ' >/dev/tty ||
        die "need /dev/tty or set SSA_NO_ASK=1; see README.md"
    printf '%s\n' "$REPLY" | sanitize_output >/dev/tty ||
        die "cannot show invalid input"
}

record_action_rejection() {
    begin_action_message
    append_log '%s\n' \
        "User rejected the action. Try something else."
    ask_user_for_rejection_reason
    finish_action_message 1
}

ask_user_for_rejection_reason() {
    printf 'reason: ' >/dev/tty ||
        die "need /dev/tty or set SSA_NO_ASK=1; see README.md"
    IFS= read -r USER_REJECTION_REASON </dev/tty ||
        die "need /dev/tty or set SSA_NO_ASK=1; see README.md"
}

run_script() {
    begin_action_message
    # Close llama input, output, and the lifeline.
    # The script must not hold them.
    # Fd 4 carries the exit code. Fd 3 is the log.
    ACTION_EXIT_CODE=$(
        exec 4>&1
        exec 3>>"$LOG_FILE"
        {
            sh -c "$(script_payload)" \
                </dev/null 2>&1 \
                3>&- 4>&- 5>&-
            printf '%s\n' "$?" >&4
        } 3>&1 | tr -d '\000' >&3
        COPY_STATUS=$?
        printf '\n' >&3 || exit 1
        exit "$COPY_STATUS"
    )
    if [ $? -ne 0 ]; then
        die "cannot append log"
    fi
    finish_action_message "$ACTION_EXIT_CODE"
}

script_payload() {
    print_action_body '^# script$'
}

print_action_body() {
    print_log_slice "$REPLY_START" "$REPLY_END" |
        sed -n "/$1/,/^# end\$/p" |
        sed '1d;$d'
}

record_output_line() {
    begin_action_message
    append_log '%s\n' "$1"
    finish_action_message "$2"
}

begin_action_message() {
    begin_log_chunk "# sent to model"
    append_log 'Output from the action:\n\n'
    OUTPUT_START=$(($(log_line_count) + 1))
}

finish_action_message() {
    OUTPUT_END=$(log_line_count)
    print_log_slice "$OUTPUT_START" "$OUTPUT_END" ||
        die "cannot show action output"
    log_user_rejection_reason
    append_log '\n\nAction exit code: %s\n' "$1"
    end_log_chunk
    ACTION_EXIT_CODE=$1
}

log_user_rejection_reason() {
    if printf '%s\n' "$USER_REJECTION_REASON" |
        grep -q '[^[:space:]]'
    then
        append_log '\nReason: %s\n' "$USER_REJECTION_REASON"
    fi
}

begin_log_chunk() {
    printf '%s\n' "$1" >>"$LOG_FILE" || die "cannot append log"
    CHUNK_START=$(($(log_line_count) + 1))
}

append_log() {
    printf "$@" >>"$LOG_FILE" || die "cannot append log"
}

end_log_chunk() {
    # The blank line after the body is outside
    # the chunk.
    CHUNK_END=$(log_line_count)
    printf '\n' >>"$LOG_FILE" || die "cannot append log"
}

log_line_count() {
    wc -l <"$LOG_FILE" | tr -d '[:space:]'
}

print_log_slice() {
    if [ "$1" -le 0 ] || [ "$2" -lt "$1" ]; then
        return 0
    fi
    sed -n "$1,$2p" "$LOG_FILE"
}

sanitize_output() {
    sed -e "s/$(printf '\r')/\\\\r/g" \
        -e "s/$(printf '\033')/\\\\e/g" \
        -e "s/$(printf '[\001-\010\013\014\016-\037\177]')/?/g"
}

file_contains_nul() {
    [ "$(wc -c <"$1" | tr -d '[:space:]')" -ne \
        "$(tr -d '\000' <"$1" | wc -c | tr -d '[:space:]')" ]
}

finish_agent_loop() {
    exec 5>&- || :
    if [ "$SSA_VERBOSE" = 1 ]; then
        printf 'log file: %s\n' "$LOG_FILE"
    fi
    printf 'done: after %s model prompts\n' "$PROMPT_COUNTER"
    exit 0
}

die() {
    trap '' PIPE
    printf '%s\n' "$*" >&2
    if [ -n "${LOG_FILE:-}" ] && [ -f "$LOG_FILE" ]; then
        printf 'log file: %s\n' "$LOG_FILE" >&2
        if [ -s "$LOG_FILE" ]; then
            printf '\n' >>"$LOG_FILE" || :
        fi
        printf '# die\n%s\n' "$*" >>"$LOG_FILE" || :
    fi
    clean_up_fifos
    if [ -n "${PID:-}" ]; then
        kill -USR1 "$PID" 2>/dev/null || :
    else
        printf 'PID not set; cannot signal parent process\n' >&2
    fi
    exit 1
}

clean_up_fifos() {
    rm -f "$(llama_fifo_path lifeline)" \
        "$(llama_fifo_path input)" \
        "$(llama_fifo_path output)" || :
}

llama_fifo_path() {
    printf '%s/ssa-%s.%s' "${TMPDIR:-/tmp}" "$PID" "$1"
}

main "$@"
