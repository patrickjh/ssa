#!/bin/sh
# ssa — Simple Shell Agent. One POSIX sh file.
# Help is README.md. This program has no -h or --help.

set -u

# Users can set
SSA_EXTRA_SYSTEM_TEXT="${SSA_EXTRA_SYSTEM_TEXT:-}"
SSA_LLAMA_CLI_ARGS="${SSA_LLAMA_CLI_ARGS:-}"
SSA_LOG_FOLDER="${SSA_LOG_FOLDER:-${TMPDIR:-/tmp}}"
SSA_NO_ASK="${SSA_NO_ASK:-0}"
SSA_NO_EDITS="${SSA_NO_EDITS:-0}"
SSA_NO_MESSAGES="${SSA_NO_MESSAGES:-0}"
SSA_NO_QUESTIONS="${SSA_NO_QUESTIONS:-0}"
SSA_NO_SCRIPTS="${SSA_NO_SCRIPTS:-0}"
SSA_NO_WRITES="${SSA_NO_WRITES:-0}"
SSA_VERBOSE="${SSA_VERBOSE:-0}"

SSA_LLAMA_CLI_ARGS="--reasoning off \
--reasoning-budget 0 \
--simple-io \
--no-display-prompt \
--no-show-timings \
--color off \
--context-shift \
--keep -1 \
${SSA_LLAMA_CLI_ARGS}"

# Internal
CHUNK_END=0
CHUNK_START=0
FIFO_DIR=""
FILE_TO_EDIT=""
FILE_TO_WRITE=""
LOG_FILE=""
LLAMA_REVERSE_PROMPT='
# end
'
OUTPUT_END=0
OUTPUT_START=0
PID=$$
PROMPT_COUNTER=0
REPLY=""
REPLY_END=0
REPLY_START=0
SYSTEM_PROMPT=""
TASK=""
USER_REJECTION_REASON=""

SYSTEM_PROMPT_INTRO='You help users solve tasks with your replies. The
task for this run is at the end of this system prompt. Later turns are
prior commands and their output. Continue from there with exactly one
of the reply formats below.
No markdown fences, no thinking tags. Put reasoning in # comments.
End every reply with a line that is exactly # end.
Put nothing after that line.'

REPLY_SPEC_HEAD='These are the valid reply formats:'

REPLY_SPEC_SCRIPT=\
'A script request is "# script" then a POSIX sh program. Each script
is a new process. The program ends before the # end line. Do not
prefix script lines with #. A body line must not be exactly # end.
Example:

# reasoning: look at the files in the folder
# script
ls -la
# end'

REPLY_SPEC_WRITE=\
'A write request is "# write file: PATH" then raw file contents.
The contents end before the # end line. A body line must not be
exactly # end. A write does not create parent directories. Prefer
this over POSIX tools for writing files because this has no quoting
issues. Example:

# reasoning: write a hello.txt file
# write file: hello.txt
hello
world
# end'

REPLY_SPEC_EDIT=\
'An edit request is "# edit file: PATH" then one SEARCH/REPLACE. The search
block must match exactly once. The next line is # end. A body line
must not be exactly # end. A search or replace line must not be
exactly ======= or >>>>>>> REPLACE. Prefer this for edits over sed
and other POSIX tools because this has no quoting issues. Example:

# reasoning: edit the hello.txt file
# edit file: hello.txt
<<<<<<< SEARCH
hello
=======
hello
world
>>>>>>> REPLACE
# end'

REPLY_SPEC_QUESTION=\
'A question request is "# question" then the question.
The question ends before the # end line. A body line
must not be exactly # end. Example:

# reasoning: the path was not in the task
# question
Which file should I edit?
# end'

REPLY_SPEC_MESSAGE=\
'A message is "# message" then text for the user.
The text ends before the # end line. A body line
must not be exactly # end. The run continues.
Example:

# reasoning: the test failure is in this file
# message
The test failure is in ssa.
# end'

REPLY_SPEC_COMPLETE=\
'The task complete marker is "# complete" in its own turn.
Do not append it to other turns. Example:

# complete
# end'

CHECK_EDIT_FORMAT_AWK='
function reject(message) {
    print message
    rejected = 1
    exit 0
}

replace_found {
    if ($0 == "# end" || $0 ~ /^[[:space:]]*$/) next
    reject("text after the replace marker")
}

!search_found && /^# edit file: ./ {
    if (edit_at) reject("the edit line is misplaced")
    edit_at = NR
    next
}

!search_found && /^<<<<<<< SEARCH$/ {
    if (!edit_at || NR != edit_at + 1)
        reject("the search marker is misplaced")
    search_found = 1
    next
}

$0 == "=======" {
    if (!edit_at || !search_found || middle_found)
        reject("the middle marker is misplaced")
    middle_found = 1
    next
}

$0 == ">>>>>>> REPLACE" {
    if (!edit_at || !search_found || !middle_found)
        reject("the replace marker is misplaced")
    replace_found = 1
    next
}

END {
    if (rejected) exit 0
    if (replace_found) exit 1
    if (!search_found)
        print "the search marker is missing"
    else if (!middle_found)
        print "the middle marker is missing"
    else print "the replace marker is missing"
    exit 0
}
'

EDIT_FILE_AWK='
function fail(message) {
    print message | "cat >&2"
    close("cat >&2")
    fail_called = 1
    exit 1
}

function load_file(line, total) {
    file_lines_count = 0
    while ((getline line < ENVIRON["FILE_TO_EDIT"]) > 0) {
        file_lines_count++
        file_array[file_lines_count] = line
        if (file_lines_count > 1) total++
        total += length(line)
    }
    close(ENVIRON["FILE_TO_EDIT"])
    if (file_lines_count == 0) return
    if (total + 1 == ENVIRON["FILE_SIZE"] + 0) file_has_final_newline = 1
    else if (total != ENVIRON["FILE_SIZE"] + 0) fail("cannot read file")
}

function require_one_match(count, start, offset) {
    count = 0
    for (start = 1; start <= file_lines_count - search_count + 1; start++) {
        for (offset = 1; offset <= search_count; offset++)
            if (file_array[start + offset - 1] != search_array[offset]) break
        if (offset > search_count) {
            count++
            match_at = start
        }
    }
    if (count != 1) fail("search block matched " count " times (need 1)")
}

function write_line(text) {
    if (wrote_line) printf("\n") > ENVIRON["FILE_TO_EDIT"]
    printf("%s", text) > ENVIRON["FILE_TO_EDIT"]
    wrote_line = 1
}

function apply_edit(number, offset) {
    printf("") > ENVIRON["FILE_TO_EDIT"]
    for (number = 1; number <= file_lines_count; number++) {
        if (number != match_at) {
            write_line(file_array[number])
            continue
        }
        for (offset = 1; offset <= replace_count; offset++)
            write_line(replace_array[offset])
        number += search_count - 1
    }
    if (file_has_final_newline && wrote_line)
      printf("\n") > ENVIRON["FILE_TO_EDIT"]
    if (close(ENVIRON["FILE_TO_EDIT"]) != 0) fail("cannot write file")
}

edit_at && NR != edit_at + 1 && !middle_found && $0 != "=======" {
    search_count++
    search_array[search_count] = $0
}
middle_found && !replace_found && $0 != ">>>>>>> REPLACE" {
    replace_count++
    replace_array[replace_count] = $0
}
!edit_at && /^# edit file: ./ { edit_at = NR }
edit_at && !middle_found && $0 == "=======" { middle_found = 1 }
middle_found && !replace_found && $0 == ">>>>>>> REPLACE" {
    replace_found = 1
}

END {
    if (fail_called) exit 1
    if (!replace_found) fail("missing replace marker")
    if (search_count == 0) fail("search block is empty")
    load_file()
    require_one_match()
    apply_edit()
}
'

main() {
    trap 'exit 1' USR1
    trap 'die "llama-cli exited; see README.md"' PIPE
    trap 'log_run_end "hangup"; clean_up_fifos; exit 129' HUP
    trap 'log_run_end "interrupt"; clean_up_fifos; exit 130' INT
    trap 'log_run_end "terminate"; clean_up_fifos; exit 143' TERM
    TASK="$*"
    check_posix_commands
    check_llama
    check_can_run
    setup_agent_loop
    run_agent_loop
    finish_agent_loop
}

check_posix_commands() {
    check_command awk
    check_command cat
    check_command date
    check_command grep
    check_command head
    check_command mkfifo
    check_command rm
    check_command sed
    check_command tr
    check_command wc
}

check_command() {
    command -v "$1" >/dev/null 2>&1 || die "$1 not found on PATH"
}

check_llama() {
    if command -v llama-cli >/dev/null 2>&1; then
        return
    fi
    command -v llama >/dev/null 2>&1 ||
        die "llama-cli or llama not found on PATH"
    llama cli --version >/dev/null 2>&1 ||
        die "llama cli --version failed"
}

check_can_run() {
    check_task
    check_no_ask
    check_no_edits
    check_no_messages
    check_no_questions
    check_no_scripts
    check_no_writes
    check_verbose
    check_log_folder
    check_llama_cli_args
    check_tty
    check_some_action_left
}

check_task() {
    [ -n "$TASK" ] || die "task not found on CLI; see README.md"
}

check_no_ask() {
    if [ "$SSA_NO_ASK" != 0 ] && [ "$SSA_NO_ASK" != 1 ]; then
        die "SSA_NO_ASK must be 0 or 1; see README.md"
    fi
}

check_no_edits() {
    if [ "$SSA_NO_EDITS" != 0 ] && [ "$SSA_NO_EDITS" != 1 ]; then
        die "SSA_NO_EDITS must be 0 or 1; see README.md"
    fi
}

check_no_messages() {
    if [ "$SSA_NO_MESSAGES" != 0 ] && [ "$SSA_NO_MESSAGES" != 1 ]; then
        die "SSA_NO_MESSAGES must be 0 or 1; see README.md"
    fi
}

check_no_questions() {
    if [ "$SSA_NO_QUESTIONS" != 0 ] && [ "$SSA_NO_QUESTIONS" != 1 ]; then
        die "SSA_NO_QUESTIONS must be 0 or 1; see README.md"
    fi
}

check_no_scripts() {
    if [ "$SSA_NO_SCRIPTS" != 0 ] && [ "$SSA_NO_SCRIPTS" != 1 ]; then
        die "SSA_NO_SCRIPTS must be 0 or 1; see README.md"
    fi
}

check_no_writes() {
    if [ "$SSA_NO_WRITES" != 0 ] && [ "$SSA_NO_WRITES" != 1 ]; then
        die "SSA_NO_WRITES must be 0 or 1; see README.md"
    fi
}

check_verbose() {
    if [ "$SSA_VERBOSE" != 0 ] && [ "$SSA_VERBOSE" != 1 ]; then
        die "SSA_VERBOSE must be 0 or 1; see README.md"
    fi
}

check_log_folder() {
    if [ ! -d "$SSA_LOG_FOLDER" ] || [ ! -w "$SSA_LOG_FOLDER" ]; then
        die "SSA_LOG_FOLDER must be a writable directory; see README.md"
    fi
}

check_llama_cli_args() {
    printf '%s\n' "$SSA_LLAMA_CLI_ARGS" |
        grep -q -E '(^|[[:space:]])(-m|--model)[[:space:]]+[^[:space:]]' ||
        die "SSA_LLAMA_CLI_ARGS needs -m or --model; see README.md"
}

check_tty() {
    ( exec <>/dev/tty ) 2>/dev/null && return
    if [ "$SSA_NO_ASK" = 0 ]; then
        die "need /dev/tty or set SSA_NO_ASK=1; see README.md"
    fi
    SSA_NO_QUESTIONS=1
    SSA_NO_MESSAGES=1
}

check_some_action_left() {
    if [ "$SSA_NO_SCRIPTS" = 1 ] && [ "$SSA_NO_WRITES" = 1 ] &&
        [ "$SSA_NO_EDITS" = 1 ] && [ "$SSA_NO_QUESTIONS" = 1 ] &&
        [ "$SSA_NO_MESSAGES" = 1 ]
    then
        die "SSA_NO_SCRIPTS, SSA_NO_WRITES, SSA_NO_EDITS," \
            "SSA_NO_QUESTIONS, and SSA_NO_MESSAGES" \
            "are all 1; see README.md"
    fi
}

setup_agent_loop() {
    setup_log
    setup_system_prompt
    start_llama
}

setup_log() {
    START_TIME=$(date '+%Y-%m-%d_%H.%M.%S')
    LOG_FILE="${SSA_LOG_FOLDER}/${START_TIME}.${PID}.ssalog"
    ( umask 077; set -C; : >"$LOG_FILE" ) || {
        LOG_FILE=""
        die "cannot create log file"
    }
    printf 'time: %s\n' "$START_TIME" >>"$LOG_FILE" || die "cannot append log"
    printf 'directory: %s\n' "$(pwd)" >>"$LOG_FILE" || die "cannot append log"
    log_llama_version
    log_environment
    if [ "$SSA_VERBOSE" = 1 ]; then
        printf 'log file: %s\n' "$LOG_FILE"
    fi
}

log_llama_version() {
    if command -v llama-cli >/dev/null 2>&1; then
        printf 'llama-cli --version\n' >>"$LOG_FILE" || die "cannot append log"
        llama-cli --version >>"$LOG_FILE" 2>&1 || :
    else
        printf 'llama cli --version\n' >>"$LOG_FILE" || die "cannot append log"
        llama cli --version >>"$LOG_FILE" 2>&1 || :
    fi
}

log_environment() {
    printf '%s\n' \
        "SSA_EXTRA_SYSTEM_TEXT=$SSA_EXTRA_SYSTEM_TEXT" \
        "SSA_LLAMA_CLI_ARGS=$SSA_LLAMA_CLI_ARGS" \
        "SSA_LOG_FOLDER=$SSA_LOG_FOLDER" "SSA_NO_ASK=$SSA_NO_ASK" \
        "SSA_NO_EDITS=$SSA_NO_EDITS" \
        "SSA_NO_MESSAGES=$SSA_NO_MESSAGES" \
        "SSA_NO_QUESTIONS=$SSA_NO_QUESTIONS" \
        "SSA_NO_SCRIPTS=$SSA_NO_SCRIPTS" \
        "SSA_NO_WRITES=$SSA_NO_WRITES" "SSA_VERBOSE=$SSA_VERBOSE" \
        "flags: -sys, SSA_LLAMA_CLI_ARGS, --reverse-prompt # end\n" \
        >>"$LOG_FILE" || die "cannot append log"
}

setup_system_prompt() {
    SYSTEM_PROMPT=$(
        printf '%s\n\n' "$SYSTEM_PROMPT_INTRO"
        print_reply_specs
        if [ -n "$SSA_EXTRA_SYSTEM_TEXT" ]; then
            printf '\n%s\n' "$SSA_EXTRA_SYSTEM_TEXT"
        fi
        printf '\n%s\n%s\n' 'The task for this run:' "$TASK"
    )
    begin_log_chunk "# system"
    printf '%s\n' "$SYSTEM_PROMPT" >>"$LOG_FILE" || die "cannot append log"
    end_log_chunk
}

print_reply_specs() {
    printf '%s' "$REPLY_SPEC_HEAD"
    if [ "$SSA_NO_SCRIPTS" = 0 ]; then
        printf '\n\n%s' "$REPLY_SPEC_SCRIPT"
    fi
    if [ "$SSA_NO_WRITES" = 0 ]; then
        printf '\n\n%s' "$REPLY_SPEC_WRITE"
    fi
    if [ "$SSA_NO_EDITS" = 0 ]; then
        printf '\n\n%s' "$REPLY_SPEC_EDIT"
    fi
    if [ "$SSA_NO_QUESTIONS" = 0 ]; then
        printf '\n\n%s' "$REPLY_SPEC_QUESTION"
    fi
    if [ "$SSA_NO_MESSAGES" = 0 ]; then
        printf '\n\n%s' "$REPLY_SPEC_MESSAGE"
    fi
    printf '\n\n%s\n' "$REPLY_SPEC_COMPLETE"
}

start_llama() {
    # Progress uses stdout. At 0, drop it before
    # llama-cli starts so load text goes there too.
    if [ "$SSA_VERBOSE" = 0 ]; then
        exec >/dev/null || die "cannot open /dev/null"
    fi
    create_fifos
    watch_llama &
    # Stays open until this process exits. That close
    # is what tells the watcher to kill llama-cli.
    exec 5>"$FIFO_DIR/lifeline" || die "cannot open llama lifeline"
    # Stdout, then stdin. Each open unblocks the matching llama-cli redirect.
    exec 4<"$FIFO_DIR/output" || die "cannot open llama-cli output"
    exec 3>"$FIFO_DIR/input" || die "cannot open llama-cli input"
}

create_fifos() {
    FIFO_DIR="${TMPDIR:-/tmp}/ssa-$PID"
    mkdir -m 700 "$FIFO_DIR" || die "cannot create fifo directory"
    mkfifo "$FIFO_DIR/lifeline" "$FIFO_DIR/input" \
        "$FIFO_DIR/output" "$FIFO_DIR/stderr" ||
        die "cannot create fifo"
}

watch_llama() {
    trap '' HUP INT TERM PIPE
    exec 5<"$FIFO_DIR/lifeline" || exit 1
    set -f
    umask 077
    copy_llama_stderr &
    # shellcheck disable=SC2086
    exec_llama \
        -sys "$SYSTEM_PROMPT" \
        $SSA_LLAMA_CLI_ARGS \
        --reverse-prompt "$LLAMA_REVERSE_PROMPT" \
        2>"$FIFO_DIR/stderr" \
        >"$FIFO_DIR/output" \
        <"$FIFO_DIR/input" &
    LLAMA_PID=$!
    cat <&5 >/dev/null
    exec 5<&-
    kill -KILL "$LLAMA_PID" 2>/dev/null || :
    # Reap llama-cli and the stderr reader.
    wait
    clean_up_fifos
}

copy_llama_stderr() {
    exec 3>&1
    STDERR=$(
        while IFS= read -r LINE || [ -n "$LINE" ]; do
            printf '%s\n' "$LINE" >&3
            printf '%s\n' "$LINE"
        done <"$FIFO_DIR/stderr"
    )
    if [ -n "$STDERR" ]; then
        printf '# llama-cli stderr\n%s\n' "$STDERR" >>"$LOG_FILE" || exit 1
    fi
}

exec_llama() {
    if command -v llama-cli >/dev/null 2>&1; then
        exec llama-cli "$@"
    else
        exec llama cli "$@"
    fi
}

run_agent_loop() {
    log_stdin_context
    while :; do
        PROMPT_COUNTER=$((PROMPT_COUNTER + 1))
        call_llama
        handle_model_response
        case $? in
            2) break ;;
            0) continue ;;
            *) die "unknown loop status $?" ;;
        esac
    done
}

log_stdin_context() {
    begin_log_chunk "# sent to model"
    append_log '%s\n' 'Context from stdin (may be blank):'
    if [ ! -t 0 ]; then
        tr -d '\000' >>"$LOG_FILE" || die "cannot append log"
        printf '\n' >>"$LOG_FILE" || die "cannot append log"
    fi
    end_log_chunk
}

call_llama() {
    print_log_slice "$CHUNK_START" "$CHUNK_END" | send_user_message
    USER_REJECTION_REASON=""
    log_llama_output
    REPLY_START=$CHUNK_START
    REPLY_END=$CHUNK_END
}

send_user_message() {
    while IFS= read -r LINE || [ -n "$LINE" ]; do
        printf '%s\\\n' "$LINE" >&3 || die "llama-cli exited; see README.md"
    done || die "cannot read user message"
    printf '\n' >&3 || die "llama-cli exited; see README.md"
}

log_llama_output() {
    begin_log_chunk "# llama-cli output"
    FIRST_REPLY_LINE=1
    while :; do
        IFS= read -r LLAMA_LINE <&4 || die "llama-cli exited; see README.md"
        LLAMA_LINE=$(printf '%s\n' "$LLAMA_LINE" | sanitize_end_line)
        printf '%s\n' "$LLAMA_LINE" >>"$LOG_FILE" || die "cannot append log"
        if [ "$FIRST_REPLY_LINE" -eq 1 ]; then
            LLAMA_LINE=$(printf '%s\n' "$LLAMA_LINE" |
                sed 's/^> \{0,1\}//' | sanitize_end_line)
            FIRST_REPLY_LINE=0
        fi
        printf '%s\n' "$LLAMA_LINE" | sanitize_output || die "cannot show reply"
        if [ "$LLAMA_LINE" = '# end' ]; then
            break
        fi
    done
    end_log_chunk
}

sanitize_end_line() {
    sed "s/^# end$(printf '\r')\$/# end/"
}

handle_model_response() {
    if [ "$(first_action_line)" = '# complete' ]; then
        return 2
    elif action_path_is_missing; then
        record_format_error "the path is missing"
    elif first_action_line | grep -q '^# write file: .'; then
        handle_write_request
    elif first_action_line | grep -q '^# edit file: .'; then
        handle_edit_request
    elif first_action_line | grep -q '^# script$'; then
        handle_script_request
    elif first_action_line | grep -q '^# question$'; then
        handle_question_request
    elif first_action_line | grep -q '^# message$'; then
        handle_message_request
    else
        record_format_error "the reply had no action line"
    fi
    return 0
}

action_path_is_missing() {
    first_action_line | grep -q -E '^# (write|edit) file:[[:space:]]*$'
}

handle_write_request() {
    if ! [ "$SSA_NO_WRITES" = 0 ]; then
        record_format_error "# write file: is not allowed"
        return
    fi
    ask_to_run_action || return
    FILE_TO_WRITE=$(first_action_line | sed 's/^# write file: //')
    apply_write_request
}

apply_write_request() {
    begin_action_message
    {
        print_action_body '^# write file: .' >"$FILE_TO_WRITE" &&
            printf 'wrote file: %s\n' "$FILE_TO_WRITE"
        ACTION_EXIT_CODE=$?
    } >>"$LOG_FILE" 2>&1 || die "cannot append log"
    printf '\n' >>"$LOG_FILE" || die "cannot append log"
    finish_action_message "$ACTION_EXIT_CODE"
}

handle_edit_request() {
    if ! [ "$SSA_NO_EDITS" = 0 ]; then
        record_format_error "# edit file: is not allowed"
    elif edit_body_has_repeated_marker_line '======='; then
        record_format_error \
            "a search or replace line must not be exactly ======="
    elif edit_body_has_repeated_marker_line '>>>>>>> REPLACE'; then
        record_format_error \
            "a search or replace line must not be exactly >>>>>>> REPLACE"
    elif EDIT_FORMAT_ERROR=$(edit_reply_format_error); then
        record_format_error "$EDIT_FORMAT_ERROR"
    elif ask_to_run_action; then
        FILE_TO_EDIT=$(first_action_line | sed 's/^# edit file: //')
        apply_edit_request
    fi
}

edit_body_has_repeated_marker_line() {
    [ "$(print_action_body '^# edit file: .' | grep -cxF -e "$1")" -gt 1 ]
}

edit_reply_format_error() {
    print_model_reply | LC_ALL=C awk "$CHECK_EDIT_FORMAT_AWK"
}

first_action_line() {
    print_model_reply | grep -E \
    '^# (complete$|write file:|edit file:|script$|question$|message$)' |
        head -n 1
}

apply_edit_request() {
    if [ ! -f "$FILE_TO_EDIT" ]; then
        record_edit_failure "$FILE_TO_EDIT" "file not found"
    elif file_contains_nul "$FILE_TO_EDIT"; then
        record_edit_failure "$FILE_TO_EDIT" "file contains a NUL"
    elif ! ERR=$(print_model_reply |
            FILE_TO_EDIT="$FILE_TO_EDIT" \
            FILE_SIZE="$(wc -c <"$FILE_TO_EDIT" | tr -d '[:space:]')" \
            LC_ALL=C awk "$EDIT_FILE_AWK" 2>&1
    ); then
        [ -n "$ERR" ] || die "edit failed with no error text"
        record_edit_failure "$FILE_TO_EDIT" "$ERR"
    else
        record_output_line "$(printf 'edited file: %s' "$FILE_TO_EDIT")" 0
    fi
}

record_edit_failure() {
    record_output_line "$(printf 'edit failed: %s: %s' "$1" "$2")" 1
}

record_output_line() {
    begin_action_message
    append_log '%s\n' "$1"
    finish_action_message "$2"
}

file_contains_nul() {
    [ "$(wc -c <"$1" | tr -d '[:space:]')" -ne \
        "$(tr -d '\000' <"$1" | wc -c | tr -d '[:space:]')" ]
}

handle_script_request() {
    if ! [ "$SSA_NO_SCRIPTS" = 0 ]; then
        record_format_error "# script is not allowed"
    elif ! script_payload | grep -q '[^[:space:]]'; then
        record_format_error "the script was empty"
    elif ! script_payload | sh -n >/dev/null 2>&1; then
        record_format_error "sh -n failed"
    elif ask_to_run_action; then
        run_script
    fi
}

ask_to_run_action() {
    if [ "$SSA_NO_ASK" = 0 ]; then
        ask_user_to_approve_action || {
            record_action_rejection
            return 1
        }
    fi
    return 0
}

ask_user_to_approve_action() {
    show_model_reply
    ring_terminal
    handle_user_answers
}

show_model_reply() {
    printf 'ssa action:\n' >/dev/tty ||
        die "need /dev/tty or set SSA_NO_ASK=1; see README.md"
    print_model_reply | sanitize_output >/dev/tty || die "cannot show reply"
}

handle_user_answers() {
    while true; do
        printf '\nApply this action? [Y]es / [N]o / [Q]uit ' >/dev/tty ||
            die "need /dev/tty or set SSA_NO_ASK=1; see README.md"
        read_ask_answer_from_tty
        case $(printf '%s\n' "$REPLY" | tr '[:upper:]' '[:lower:]') in
            y|yes) return 0 ;;
            n|no) return 1 ;;
            q|quit) die "User chose to quit." ;;
            *) print_invalid_input ;;
        esac
    done
}

read_ask_answer_from_tty() {
    IFS= read -r REPLY </dev/tty ||
        die "need /dev/tty or set SSA_NO_ASK=1; see README.md"
    begin_log_chunk "# apply this action? user answer"
    printf '%s\n' "$REPLY" >>"$LOG_FILE" || die "cannot append log"
    end_log_chunk
}

print_invalid_input() {
    printf 'invalid input: ' >/dev/tty ||
        die "need /dev/tty or set SSA_NO_ASK=1; see README.md"
    printf '%s\n' "$REPLY" | sanitize_output >/dev/tty ||
        die "cannot show invalid input"
}

record_action_rejection() {
    begin_action_message
    append_log '%s\n' "User rejected the action. Try something else."
    ask_user_for_rejection_reason
    finish_action_message 1
}

ask_user_for_rejection_reason() {
    printf 'reason: ' >/dev/tty ||
        die "need /dev/tty or set SSA_NO_ASK=1; see README.md"
    IFS= read -r USER_REJECTION_REASON </dev/tty ||
        die "need /dev/tty or set SSA_NO_ASK=1; see README.md"
}

run_script() {
    begin_action_message
    # Close llama input, output, and the lifeline.
    # The script must not hold them.
    # Fd 4 carries the exit code. Fd 3 is the log.
    ACTION_EXIT_CODE=$(
        exec 4>&1
        exec 3>>"$LOG_FILE"
        {
            sh -c "$(script_payload)" </dev/null 2>&1 3>&- 4>&- 5>&-
            printf '%s\n' "$?" >&4
        } 3>&1 | tr -d '\000' >&3
        COPY_STATUS=$?
        printf '\n' >&3 || exit 1
        exit "$COPY_STATUS"
    )
    if [ $? -ne 0 ]; then
        die "cannot append log"
    fi
    finish_action_message "$ACTION_EXIT_CODE"
}

begin_action_message() {
    begin_log_chunk "# sent to model"
    append_log 'Output from the action:\n\n'
    OUTPUT_START=$(($(log_line_count) + 1))
}

script_payload() {
    print_action_body '^# script$'
}

finish_action_message() {
    OUTPUT_END=$(log_line_count)
    print_log_slice "$OUTPUT_START" "$OUTPUT_END" ||
         die "cannot show action output"
    log_user_rejection_reason
    append_log '\n\nAction exit code: %s\n' "$1"
    end_log_chunk
}

log_user_rejection_reason() {
    if printf '%s\n' "$USER_REJECTION_REASON" | grep -q '[^[:space:]]'; then
        append_log '\nReason: %s\n' "$USER_REJECTION_REASON"
    fi
}

handle_question_request() {
    if [ "$SSA_NO_QUESTIONS" != 0 ]; then
        record_format_error "# question is not allowed"
    elif ! print_action_body '^# question$' | grep -q '[^[:space:]]'; then
        record_format_error "the question was empty"
    else
        ask_question
    fi
}

ask_question() {
    print_action_body '^# question$' | sanitize_output >/dev/tty ||
        die "need /dev/tty or set SSA_NO_QUESTIONS=1; see README.md"
    ring_terminal
    IFS= read -r REPLY </dev/tty ||
        die "need /dev/tty or set SSA_NO_QUESTIONS=1; see README.md"
    begin_log_chunk "# sent to model"
    append_log '%s\n' "$REPLY"
    end_log_chunk
}

handle_message_request() {
    if [ "$SSA_NO_MESSAGES" != 0 ]; then
        record_format_error "# message is not allowed"
    elif ! print_action_body '^# message$' | grep -q '[^[:space:]]'; then
        record_format_error "the message was empty"
    else
        show_message
    fi
}

record_format_error() {
    printf '%s\n' "$*"
    begin_log_chunk "# sent to model"
    append_log '%s\n' "$*"
    end_log_chunk
}

show_message() {
    print_action_body '^# message$' | sanitize_output >/dev/tty ||
        die "need /dev/tty or set SSA_NO_MESSAGES=1; see README.md"
    ring_terminal
    begin_log_chunk "# sent to model"
    append_log '%s\n' "The user was shown the message."
    end_log_chunk
}

print_action_body() {
    print_model_reply | sed -n "/$1/,/^# end\$/p" | sed '1d;$d'
}

print_model_reply() {
    print_log_slice "$REPLY_START" "$REPLY_END" | sed '1s/^> \{0,1\}//'
}

print_log_slice() {
    if [ "$1" -le 0 ] || [ "$2" -lt "$1" ]; then
        return 0
    fi
    sed -n "$1,$2p" "$LOG_FILE"
}

sanitize_output() {
    LC_ALL=C sed -e "s/$(printf '\r')/\\\\r/g" \
        -e "s/$(printf '\033')/\\\\e/g" \
        -e "s/$(printf '[\001-\010\013\014\016-\037\177]')/?/g"
}

ring_terminal() {
    printf '\a' >/dev/tty || die "need /dev/tty; see README.md"
}

begin_log_chunk() {
    printf '%s\n' "$1" >>"$LOG_FILE" || die "cannot append log"
    CHUNK_START=$(($(log_line_count) + 1))
}

append_log() {
    printf "$@" >>"$LOG_FILE" || die "cannot append log"
}

end_log_chunk() {
    # The blank line after the body is outside the chunk.
    CHUNK_END=$(log_line_count)
    printf '\n' >>"$LOG_FILE" || die "cannot append log"
}

log_line_count() {
    wc -l <"$LOG_FILE" | tr -d '[:space:]'
}

die() {
    trap '' PIPE
    printf '%s\n' "$*" >&2
    if [ -n "${LOG_FILE:-}" ] && [ -f "$LOG_FILE" ]; then
        printf 'log file: %s\n' "$LOG_FILE" >&2
    fi
    log_run_end "die: $*"
    clean_up_fifos
    if [ -n "${PID:-}" ]; then
        kill -USR1 "$PID" 2>/dev/null || :
    else
        printf 'PID not set; cannot signal parent process\n' >&2
    fi
    exit 1
}

clean_up_fifos() {
    # The write end stays open in this process.
    # The watcher closes its read end, then removes the pipes.
    if [ -n "${FIFO_DIR:-}" ] && ! (true >&5) 2>/dev/null; then
        rm -rf "$FIFO_DIR" || :
    fi
}

finish_agent_loop() {
    log_run_end "completed"
    exec 5>&- || :
    if [ "$SSA_VERBOSE" = 1 ]; then
        printf 'log file: %s\n' "$LOG_FILE"
    fi
    printf 'done: after %s model prompts\n' "$PROMPT_COUNTER"
    exit 0
}

log_run_end() {
    if [ -z "${LOG_FILE:-}" ] || [ ! -f "$LOG_FILE" ]; then
        return 0
    fi
    printf '\ntime: %s\n' "$(date '+%Y-%m-%d_%H.%M.%S')" >>"$LOG_FILE" || :
    printf 'status: %s\n' "$1" >>"$LOG_FILE" || :
}

main "$@"
