#!/bin/sh
# ssa — Simple Shell Agent. One POSIX sh file.
# Help is README.md. Flags are -v, -y, and -m. No -h.

set -u

# Users can set
SSA_ASSUME_YES="${SSA_ASSUME_YES:-0}"
SSA_EXTRA_SYSTEM_TEXT="${SSA_EXTRA_SYSTEM_TEXT:-}"
SSA_KEY="${SSA_KEY:-}"
SSA_LOG_FOLDER="${SSA_LOG_FOLDER:-${TMPDIR:-/tmp}}"
SSA_MAX_CONTEXT_BYTES="${SSA_MAX_CONTEXT_BYTES:-0}"
SSA_MAX_MODEL_PROMPTS="${SSA_MAX_MODEL_PROMPTS:-20}"
SSA_MODEL="${SSA_MODEL:-}"
SSA_NO_CHAT="${SSA_NO_CHAT:-0}"
SSA_NO_EDITS="${SSA_NO_EDITS-0}"
SSA_NO_SCRIPTS="${SSA_NO_SCRIPTS:-0}"
SSA_NO_WRITES="${SSA_NO_WRITES-0}"
SSA_REQUEST_JSON="${SSA_REQUEST_JSON:-}"
SSA_URL="${SSA_URL:-}"
SSA_VERBOSE="${SSA_VERBOSE:-0}"

# Internal
unset PID PROMPT_COUNTER LOG_FILE LOOP_STATUS
ACTION_EXIT=0
ACTION_OUTPUT=""
ACTION_RAW=""
ASK_NO=1
ASK_YES=0
AUTH_KEY=""
CURL_RESPONSE=""
HIT_MAX=2
IS_FALSE=1
IS_TRUE=0
JQ_BINARY_FLAG=""
LOG_FILE=""
LOOP_AGAIN=0
PID=$$
PROMPT_COUNTER=0
TASK=""
TASK_DONE=1
UPDATED=""
USER_REJECTION_REASON=""
USER_REPLY=""

SYSTEM_PROMPT='You help users solve tasks with your replies. The
task is at the end of this prompt. Continue from your last reply with
exactly one format below. No markdown fences, no thinking tags. Put
reasoning in # comments.'
REPLY_SPEC='These are the valid reply formats:'
REPLY_SPEC_SCRIPT='

A script reply is a POSIX sh program and nothing else. Each program
is a new process. Example:

# reasoning: look at the files in the folder
ls -la'
REPLY_SPEC_WRITE='

A write request is "# write file: PATH" then raw file contents.
A write does not create parent directories. Prefer this over POSIX
tools for writing files because this has no quoting issues. Example:

# reasoning: write a hello.txt file
# write file: hello.txt
hello
world'
REPLY_SPEC_EDIT='

An edit request is "# edit file: PATH" then one SEARCH/REPLACE. The
search block must not be empty and must match exactly once. A search
or replace line must not be exactly ======= or >>>>>>> REPLACE.
Prefer this for edits over sed and other POSIX tools because this has
no quoting issues. Example:

# reasoning: edit the hello.txt file
# edit file: hello.txt
<<<<<<< SEARCH
hello
=======
hello
world
>>>>>>> REPLACE'
REPLY_SPEC_CHAT='

A chat request is "# chat" then text for the user. The next user
turn is the line the user wrote, or "The user sent no text." Example:

# reasoning: the path was not in the task
# chat
Which file should I edit?'
REPLY_SPEC_COMPLETE='

The task complete marker is "# complete" as the last line of the
reply. Alone it stops the run. As the last line of a script, the
script runs and then the run stops if the script succeeds. Example:

# complete'
CHECK_EDIT_FORMAT_AWK='
search_found && !middle_found && $0 != "=======" {
    search_count++
}
replace_found && $0 !~ /^[[:space:]]*$/ { bad = 1 }
!search_found && /^# edit file: ./ {
    if (edit_at) bad = 1
    edit_at = NR
}
!search_found && /^<<<<<<< SEARCH$/ {
    if (!edit_at || NR != edit_at + 1) bad = 1
    search_found = 1
}
$0 == "=======" {
    if (!edit_at || !search_found || middle_found) bad = 1
    middle_found = 1
}
$0 == ">>>>>>> REPLACE" {
    if (!edit_at || !search_found || !middle_found) bad = 1
    replace_found = 1
}
END {
    if (bad || !replace_found || search_count == 0) {
        print "bad"
        exit 1
    }
}
'
EDIT_FILE_AWK='
function fail(message) {
    print message
    fail_called = 1
    exit 1
}
function load_file(line, total, status) {
    if (ENVIRON["FILE_SIZE"] == "") fail("cannot read file")
    file_lines_count = 0
    while ((status = (getline line < ENVIRON["FILE_TO_EDIT"])) > 0) {
        file_lines_count++
        file_array[file_lines_count] = line
        if (file_lines_count > 1) total++
        total += length(line)
    }
    close(ENVIRON["FILE_TO_EDIT"])
    if (status < 0) fail("cannot read file")
    if (file_lines_count == 0) return
    if (total + 1 == ENVIRON["FILE_SIZE"] + 0) file_has_final_newline = 1
    else if (total != ENVIRON["FILE_SIZE"] + 0) fail("cannot read file")
}
function require_one_match(count, start, offset) {
    count = 0
    for (start = 1; \
        start <= file_lines_count - search_count + 1; start++) {
        for (offset = 1; offset <= search_count; offset++)
            if (file_array[start + offset - 1] != search_array[offset]) break
        if (offset > search_count) {
            count++
            match_at = start
        }
    }
    if (count != 1) fail("search block matched " count " times (need 1)")
}
function write_line(text) {
    if (wrote_line) printf("\n") > ENVIRON["FILE_TO_EDIT"]
    printf("%s", text) > ENVIRON["FILE_TO_EDIT"]
    wrote_line = 1
}
function apply_edit(number, offset) {
    printf("") > ENVIRON["FILE_TO_EDIT"]
    for (number = 1; number <= file_lines_count; number++) {
        if (number != match_at) {
            write_line(file_array[number])
            continue
        }
        for (offset = 1; offset <= replace_count; offset++)
            write_line(replace_array[offset])
        number += search_count - 1
    }
    if (file_has_final_newline && wrote_line)
        printf("\n") > ENVIRON["FILE_TO_EDIT"]
    if (close(ENVIRON["FILE_TO_EDIT"]) != 0) fail("cannot write file")
}
edit_at && NR != edit_at + 1 && !middle_found && $0 != "=======" {
    search_count++
    search_array[search_count] = $0
}
middle_found && !replace_found && $0 != ">>>>>>> REPLACE" {
    replace_count++
    replace_array[replace_count] = $0
}
!edit_at && /^# edit file: ./ { edit_at = NR }
edit_at && !middle_found && $0 == "=======" { middle_found = 1 }
middle_found && !replace_found && $0 == ">>>>>>> REPLACE" {
    replace_found = 1
}
END {
    if (fail_called) exit 1
    if (!replace_found) fail("missing replace marker")
    if (search_count == 0) fail("search block is empty")
    load_file()
    require_one_match()
    apply_edit()
}
'
# Pin messages 0 and 1 (system, first user). Drop the oldest
# assistant/user pair while content length is over budget and a
# pair remains after the newest one. Budget 0 sends every turn.
CONTEXT_WINDOW_JQ='
def nbytes: map(.content | length) | add // 0;
def drop_pair: .[0:2] + .[4:];
def over: nbytes > $budget;
def droppable: length > 4 and .[1].role != .[4].role;
(.messages
  | if $budget == 0 then .
    else until((over | not) or (droppable | not); drop_pair)
    end) as $kept
| $extra + {model: $model, messages: $kept}
'

main() {
    trap 'exit 1' USR1
    read_command_line "$@"
    check_required_commands
    check_can_run
    setup_agent_loop
    run_agent_loop
    finish_agent_loop
}
read_command_line() {
    while [ $# -gt 0 ]; do
        case $1 in
            -v) SSA_VERBOSE=1 ;;
            -y) SSA_ASSUME_YES=1 ;;
            -m)
                shift
                [ -n "${1:-}" ] ||
                    die "-m needs a model; see README.md"
                SSA_MODEL=$1
                ;;
            --) shift; break ;;
            -*) die "unknown flag $1; see README.md" ;;
            *) break ;;
        esac
        shift
    done
    TASK="$*"
}
check_required_commands() {
    for COMMAND in awk curl date grep head jq rm sed tr wc
    do
        command -v "$COMMAND" >/dev/null 2>&1 || die "$COMMAND not on PATH"
    done
}
check_can_run() {
    check_task_is_set
    check_max_context_bytes
    check_max_model_prompts
    check_zero_or_one "$SSA_ASSUME_YES" "SSA_ASSUME_YES"
    check_zero_or_one "$SSA_NO_CHAT" "SSA_NO_CHAT"
    check_zero_or_one "$SSA_NO_EDITS" "SSA_NO_EDITS"
    check_zero_or_one "$SSA_NO_SCRIPTS" "SSA_NO_SCRIPTS"
    check_zero_or_one "$SSA_NO_WRITES" "SSA_NO_WRITES"
    check_zero_or_one "$SSA_VERBOSE" "SSA_VERBOSE"
    check_log_folder
    check_model_is_set
    check_url_is_set
    check_request_json
    check_prompt_device
    check_some_action_left
}
check_task_is_set() {
    [ -n "$TASK" ] || die "task not found on CLI; see README.md"
}
check_max_context_bytes() {
    case $SSA_MAX_CONTEXT_BYTES in
        *[!0-9]*) die "invalid SSA_MAX_CONTEXT_BYTES; see README.md" ;;
    esac
}
check_max_model_prompts() {
    case $SSA_MAX_MODEL_PROMPTS in
        *[!0-9]*) die "invalid SSA_MAX_MODEL_PROMPTS; see README.md" ;;
    esac
}
check_zero_or_one() {
    if [ "$1" != 0 ] && [ "$1" != 1 ]; then
        die "$2 must be 0 or 1; see README.md"
    fi
}
check_log_folder() {
    if [ ! -d "$SSA_LOG_FOLDER" ] || [ ! -w "$SSA_LOG_FOLDER" ]; then
        die "SSA_LOG_FOLDER must be a writable directory; see README.md"
    fi
}
check_model_is_set() {
    [ -n "$SSA_MODEL" ] || die "SSA_MODEL not set; see README.md"
}
check_url_is_set() {
    [ -n "$SSA_URL" ] || die "SSA_URL not set; see README.md"
}
check_request_json() {
    if [ -z "$SSA_REQUEST_JSON" ]; then return; fi
    printf '%s' "$SSA_REQUEST_JSON" |
        jq -e 'type == "object"' >/dev/null 2>&1 ||
        die "SSA_REQUEST_JSON must be a JSON object; see README.md"
}
check_prompt_device() {
    if ( exec </dev/tty ) 2>/dev/null; then
        return
    fi
    if [ "$SSA_ASSUME_YES" = 0 ]; then
        die "need /dev/tty or set SSA_ASSUME_YES=1; see README.md"
    fi
    SSA_NO_CHAT=1
}
check_some_action_left() {
    if [ "$SSA_NO_SCRIPTS" = 1 ] && [ "$SSA_NO_WRITES" = 1 ] &&
        [ "$SSA_NO_EDITS" = 1 ] && [ "$SSA_NO_CHAT" = 1 ]
    then
        die "SSA_NO_SCRIPTS, SSA_NO_WRITES, SSA_NO_EDITS," \
            "and SSA_NO_CHAT are all 1; see README.md"
    fi
}
setup_agent_loop() {
    setup_jq_binary_flag
    setup_log
    log_settings
    note "start: $SSA_MODEL at $SSA_URL"
    note "log file: $LOG_FILE"
    keep_auth_key
    log_context
    setup_exit_traps
    setup_messages
}
setup_jq_binary_flag() {
    # Some jq builds write CRLF unless -b (binary stdout) is set.
    # jq 1.6 and older lack -b, so only use it when it works.
    JQ_BINARY_FLAG=""
    if jq -b -n '""' >/dev/null 2>&1; then JQ_BINARY_FLAG="-b"; fi
}
setup_log() {
    START_TIME=$(date '+%Y-%m-%d_%H.%M.%S')
    LOG_FILE="${SSA_LOG_FOLDER}/${START_TIME}.${PID}.json"
    # shellcheck disable=SC2086
    ( umask 077; set -C
      jq $JQ_BINARY_FLAG -n \
          --arg time "$START_TIME" \
          --arg directory "$(pwd)" \
          --arg url "$SSA_URL" \
          --arg task "$TASK" \
          '{time:$time, directory:$directory, url:$url, task:$task,
            context:"", status:"running", settings:"",
            messages:[], turns:[]}' >"$LOG_FILE" ) || {
        rm -f "$LOG_FILE"
        LOG_FILE=""
        die "cannot write log"
    }
}
log_settings() {
    save_log --arg settings "$(printf '%s\n' \
        "SSA_EXTRA_SYSTEM_TEXT=$SSA_EXTRA_SYSTEM_TEXT" \
        "SSA_LOG_FOLDER=$SSA_LOG_FOLDER" \
        "SSA_MAX_CONTEXT_BYTES=$SSA_MAX_CONTEXT_BYTES" \
        "SSA_MAX_MODEL_PROMPTS=$SSA_MAX_MODEL_PROMPTS" \
        "SSA_MODEL=$SSA_MODEL" \
        "SSA_ASSUME_YES=$SSA_ASSUME_YES" \
        "SSA_NO_CHAT=$SSA_NO_CHAT" \
        "SSA_NO_EDITS=$SSA_NO_EDITS" \
        "SSA_NO_SCRIPTS=$SSA_NO_SCRIPTS" \
        "SSA_NO_WRITES=$SSA_NO_WRITES" \
        "SSA_REQUEST_JSON=$SSA_REQUEST_JSON" \
        "SSA_VERBOSE=$SSA_VERBOSE")" \
        '.settings = $settings'
}
keep_auth_key() {
    AUTH_KEY=$SSA_KEY
    unset SSA_KEY
}
log_context() {
    if [ -t 0 ]; then return; fi
    # shellcheck disable=SC2086
    UPDATED=$(tr -d '\000' | jq $JQ_BINARY_FLAG -Rs \
        --slurpfile log "$LOG_FILE" \
        '$log[0] + {context:.}') ||
        die "context is not valid UTF-8; see README.md"
    commit_log || die "cannot update log"
}
setup_exit_traps() {
    trap 'exit 129' HUP
    trap 'exit 130' INT
    trap 'exit 143' TERM
}
setup_messages() {
    setup_reply_spec
    setup_system_prompt
    # shellcheck disable=SC2086
    UPDATED=$(printf '%s' "$SYSTEM_PROMPT" |
        jq $JQ_BINARY_FLAG -Rs \
            --arg no_context 'No context was given on stdin.' \
            --slurpfile log "$LOG_FILE" \
            '. as $text | $log[0] | .messages = [
               {role:"system", content:$text},
               {role:"user",
                content:(if $log[0].context == "" then $no_context
                         else $log[0].context end)}]') ||
        die "cannot write chat messages"
    commit_log || die "cannot write chat messages"
}
setup_reply_spec() {
    if scripts_are_enabled; then
        REPLY_SPEC="$REPLY_SPEC$REPLY_SPEC_SCRIPT"
    fi
    if writes_are_enabled; then
        REPLY_SPEC="$REPLY_SPEC$REPLY_SPEC_WRITE"
    fi
    if edits_are_enabled; then
        REPLY_SPEC="$REPLY_SPEC$REPLY_SPEC_EDIT"
    fi
    if chats_are_enabled; then
        REPLY_SPEC="$REPLY_SPEC$REPLY_SPEC_CHAT"
    fi
    REPLY_SPEC="$REPLY_SPEC$REPLY_SPEC_COMPLETE"
}
setup_system_prompt() {
    SYSTEM_PROMPT="$SYSTEM_PROMPT

$REPLY_SPEC"
    if [ -n "$SSA_EXTRA_SYSTEM_TEXT" ]; then
        SYSTEM_PROMPT="$SYSTEM_PROMPT

$SSA_EXTRA_SYSTEM_TEXT"
    fi
    SYSTEM_PROMPT="$SYSTEM_PROMPT

The task for this run:
$TASK
"
}
run_agent_loop() {
    while :; do
        PROMPT_COUNTER=$((PROMPT_COUNTER + 1))
        note "prompt $PROMPT_COUNTER"
        prompt_model_then_run_script
        case $? in
            $TASK_DONE) LOOP_STATUS="done"; break ;;
            $HIT_MAX) LOOP_STATUS="hit max"; break ;;
            $LOOP_AGAIN) continue ;;
            *) die "unknown loop status $?" ;;
        esac
    done
}
prompt_model_then_run_script() {
    if over_model_prompt_limit; then return $HIT_MAX; fi
    USER_REJECTION_REASON=""
    ACTION_OUTPUT=""
    ACTION_EXIT=0
    call_curl
    handle_model_response
}
over_model_prompt_limit() {
    [ "$SSA_MAX_MODEL_PROMPTS" -gt 0 ] &&
        [ "$PROMPT_COUNTER" -gt "$SSA_MAX_MODEL_PROMPTS" ]
}
call_curl() {
    begin_model_turn
    send_curl_json_request
    save_model_turn
}
begin_model_turn() {
    if [ -n "$SSA_REQUEST_JSON" ]; then
        REQUEST_EXTRA="$SSA_REQUEST_JSON"
    else
        REQUEST_EXTRA="{}"
    fi
    # shellcheck disable=SC2086
    save_log \
        --arg model "$SSA_MODEL" \
        --argjson budget "$SSA_MAX_CONTEXT_BYTES" \
        --argjson extra "$REQUEST_EXTRA" \
        "($CONTEXT_WINDOW_JQ)"' as $body
          | .turns += [{request:$body, response:"", reply:"",
                        output:"", exit_code:null}]'
}
send_curl_json_request() {
    note "curl $SSA_URL"
    # shellcheck disable=SC2086
    if [ -n "$AUTH_KEY" ]; then
        CURL_RESPONSE=$(post_curl -H "Authorization: Bearer $AUTH_KEY") ||
            die "curl failed; see README.md"
    else
        CURL_RESPONSE=$(post_curl) || die "curl failed; see README.md"
    fi
}
post_curl() {
    # shellcheck disable=SC2086
    jq $JQ_BINARY_FLAG -cj '.turns[-1].request' "$LOG_FILE" |
        curl -sS --fail \
            --retry 4 --retry-connrefused --retry-max-time 120 \
            --connect-timeout 30 --max-time 900 \
            -H "Content-Type: application/json" \
            "$@" \
            --data-binary @- \
            "$SSA_URL"
}
save_model_turn() {
    # shellcheck disable=SC2086
    if printf '%s' "$CURL_RESPONSE" | jq $JQ_BINARY_FLAG -e \
        '.choices[0].message.content | type == "string"' \
        >/dev/null 2>&1
    then
        UPDATED=$(printf '%s' "$CURL_RESPONSE" |
            jq $JQ_BINARY_FLAG -Rs --slurpfile log "$LOG_FILE" \
                '. as $raw | ($raw | fromjson) as $parsed | $log[0]
                 | .turns[-1].response = $raw
                 | .turns[-1].reply =
                     $parsed.choices[0].message.content') ||
            die "cannot update log"
        commit_log || die "cannot update log"
        return
    fi
    UPDATED=$(printf '%s' "$CURL_RESPONSE" |
        jq $JQ_BINARY_FLAG -Rs --slurpfile log "$LOG_FILE" \
            '. as $raw | $log[0]
             | .turns[-1].response = $raw
             | .turns[-1].reply = ""') || UPDATED=""
    if [ -n "$UPDATED" ]; then
        commit_log || :
    fi
    die "invalid chat response; see README.md"
}
handle_model_response() {
    append_assistant_turn
    if agent_is_done; then
        note "reply: complete"
        return $TASK_DONE
    fi
    if reply_is_blank; then record_format_error
    elif action_path_is_missing; then
        record_format_error "the path is missing"
    elif reply_is_write_request; then
        note "reply: write"
        handle_write_request
    elif reply_is_edit_request; then
        note "reply: edit"
        handle_edit_request
    elif reply_is_chat_request; then
        note "reply: chat"
        handle_chat_request
    elif scripts_are_enabled; then
        note "reply: script"
        handle_script_request
        if [ $? -eq $TASK_DONE ]; then return $TASK_DONE; fi
    else record_format_error
    fi
    return $LOOP_AGAIN
}
append_assistant_turn() {
    save_log \
        '.messages += [{role:"assistant", content:.turns[-1].reply}]'
}
agent_is_done() {
    [ "$(print_model_reply)" = '# complete' ]
}
reply_is_blank() {
    print_model_reply | grep -q '[^[:space:]]' && return 1
    return 0
}
action_path_is_missing() {
    if ! writes_are_enabled && ! edits_are_enabled; then return 1; fi
    first_action_line | grep -q -E \
        '^# (write|edit) file:([[:space:]]*$|[^ ]| [[:space:]])'
}
reply_is_write_request() {
    if ! writes_are_enabled; then return 1; fi
    first_action_line | grep -q '^# write file: .'
}
handle_write_request() {
    ask_to_run || return
    apply_write_request
}
writes_are_enabled() {
    [ "$SSA_NO_WRITES" = 0 ]
}
apply_write_request() {
    WRITE_PATH=$(first_action_line | sed 's/^# write file: //')
    ACTION_RAW=$(
        { action_body '^# write file: .' >"$WRITE_PATH" &&
            printf 'wrote file: %s\n' "$WRITE_PATH"
        } 2>&1
        status=$?
        printf '\n.'
        exit $status
    )
    store_action_result $?
    show_action_output
    append_script_result
}
reply_is_edit_request() {
    if ! edits_are_enabled; then return 1; fi
    first_action_line | grep -q '^# edit file: .'
}
handle_edit_request() {
    if ! EDIT_FORMAT_MESSAGE=$(edit_format_is_ok); then
        if [ -z "$EDIT_FORMAT_MESSAGE" ]; then
            die "cannot check edit format"
        fi
        record_format_error "$REPLY_SPEC_EDIT"
        return
    fi
    apply_edit_request
}
edits_are_enabled() {
    [ "$SSA_NO_EDITS" = 0 ]
}
edit_format_is_ok() {
    print_model_reply | LC_ALL=C awk "$CHECK_EDIT_FORMAT_AWK"
}
apply_edit_request() {
    EDIT_PATH=$(first_action_line | sed 's/^# edit file: //')
    if [ ! -f "$EDIT_PATH" ]; then
        record_edit_failure "$EDIT_PATH" "cannot read file"
        return
    fi
    ask_to_run || return
    run_edit_awk
}
run_edit_awk() {
    EDIT_AWK_MESSAGE=$(
        print_model_reply |
            FILE_TO_EDIT="$EDIT_PATH" \
            FILE_SIZE="$(wc -c <"$EDIT_PATH" | tr -d '[:space:]')" \
            LC_ALL=C awk "$EDIT_FILE_AWK" 2>&1
    )
    if [ $? -eq 0 ]; then
        ACTION_OUTPUT="edited file: ${EDIT_PATH}
"
        ACTION_EXIT=0
        show_action_output
        append_script_result
    elif [ -n "$EDIT_AWK_MESSAGE" ]; then
        record_edit_failure "$EDIT_PATH" "$EDIT_AWK_MESSAGE"
    else
        die "edit failed with no error text"
    fi
}
record_edit_failure() {
    ACTION_OUTPUT="edit failed: $1: $2
"
    ACTION_EXIT=1
    show_action_output
    append_script_result
}
handle_script_request() {
    if reply_has_fence_line; then record_format_error
    elif reply_has_thinking_tags; then record_format_error
    elif ! reply_is_valid_shell; then record_format_error
    elif ask_to_run; then
        run_script
        if [ "$ACTION_EXIT" = 0 ] && reply_ends_with_complete; then
            return $TASK_DONE
        fi
    fi
}
reply_ends_with_complete() {
    [ "$(print_model_reply | grep . | sed -n '$p')" = '# complete' ]
}
scripts_are_enabled() {
    [ "$SSA_NO_SCRIPTS" = 0 ]
}
reply_has_fence_line() {
    print_model_reply | grep -q '^```'
}
reply_has_thinking_tags() {
    print_model_reply | grep -qF \
        -e '<think>' \
        -e '</think>' \
        -e '<|channel>thought'
}
reply_is_valid_shell() {
    print_model_reply | sh -n >/dev/null 2>&1
}
ask_to_run() {
    if [ "$SSA_ASSUME_YES" = 0 ]; then
        ask_user_to_approve_action || {
            record_action_rejection
            return $IS_FALSE
        }
    fi
    return $IS_TRUE
}
ask_user_to_approve_action() {
    show_model_reply
    ring_terminal
    handle_user_answers
}
show_model_reply() {
    printf 'ssa action:\n' >/dev/tty ||
        die "need /dev/tty or set SSA_ASSUME_YES=1; see README.md"
    print_model_reply | sanitize_output >/dev/tty ||
        die "cannot show reply"
}
handle_user_answers() {
    while :; do
        printf '\nApply this action? [Y]es / [N]o / [Q]uit ' >/dev/tty ||
            die "need /dev/tty or set SSA_ASSUME_YES=1; see README.md"
        read_user_line "need /dev/tty or set SSA_ASSUME_YES=1; see README.md"
        case "$USER_REPLY" in
            y|Y|yes|YES) return $ASK_YES ;;
            n|N|no|NO) return $ASK_NO ;;
            q|Q|quit|QUIT) die 'User chose to quit.' ;;
            *) print_invalid_input ;;
        esac
    done
}
print_invalid_input() {
    printf 'invalid input: ' >/dev/tty ||
        die "need /dev/tty or set SSA_ASSUME_YES=1; see README.md"
    printf '%s\n' "$USER_REPLY" | sanitize_output >/dev/tty ||
        die "cannot show invalid input"
}
record_action_rejection() {
    note "user rejected the action"
    ACTION_OUTPUT="User rejected the action. Try something else.
"
    ACTION_EXIT=1
    show_action_output
    ask_user_for_rejection_reason
    append_script_result
}
ask_user_for_rejection_reason() {
    printf 'reason: ' >/dev/tty ||
        die "need /dev/tty or set SSA_ASSUME_YES=1; see README.md"
    read_user_line "need /dev/tty or set SSA_ASSUME_YES=1; see README.md"
    USER_REJECTION_REASON="$USER_REPLY"
}
run_script() {
    ACTION_RAW=$(
        sh -c "$(print_model_reply)" </dev/null 2>&1
        status=$?
        printf '\n.'
        exit $status
    )
    store_action_result $?
    show_action_output
    append_script_result
}
store_action_result() {
    ACTION_EXIT=$1
    ACTION_OUTPUT=${ACTION_RAW%.}
    # $( ) drops a trailing newline, so protect it with a dot.
    NL=$(printf '\n.')
    NL=${NL%.}
    ACTION_OUTPUT=${ACTION_OUTPUT%"$NL"}
    ACTION_RAW=$(printf '%s.' "$ACTION_OUTPUT" | tr -d '\000')
    ACTION_OUTPUT=${ACTION_RAW%.}
}
append_script_result() {
    if ! output_is_json_safe; then
        ACTION_OUTPUT='Output omitted: not valid UTF-8 (binary bytes).
'
        save_turn_output
        save_omitted_user_message
        return
    fi
    save_turn_output
    save_script_user_message
}
output_is_json_safe() {
    # shellcheck disable=SC2086
    printf '%s' "$ACTION_OUTPUT" | jq $JQ_BINARY_FLAG -e -Rs \
        'contains("\u0000") | not' >/dev/null 2>&1
}
save_omitted_user_message() {
    save_log --arg note 'Output omitted: not valid UTF-8 (binary bytes).' \
        '.messages += [{role:"user", content:(
           $note + "\n\nScript exit code: "
           + (.turns[-1].exit_code | tostring) + "\n")}]'
}
save_script_user_message() {
    SHOW_REASON=0
    if printf '%s\n' "$USER_REJECTION_REASON" |
        grep -q '[^[:space:]]'
    then
        SHOW_REASON=1
    fi
    save_log --arg reason "$USER_REJECTION_REASON" \
        --argjson show_reason "$SHOW_REASON" \
        '.turns[-1] as $turn
         | .messages += [{role:"user", content:(
             "Output from running the script:\n\n"
             + $turn.output
             + (if $show_reason == 1 then
                  "\nReason: " + $reason + "\n"
                else "" end)
             + "\n\nScript exit code: "
             + ($turn.exit_code | tostring) + "\n")}]'
}
save_log() {
    try_save_log "$@" || die "cannot update log"
}
reply_is_chat_request() {
    if ! chats_are_enabled; then return 1; fi
    first_action_line | grep -q '^# chat$'
}
handle_chat_request() {
    if ! action_body '^# chat$' | grep -q '[^[:space:]]'; then
        record_format_error "the chat was empty"
    else
        ask_chat
    fi
}
chats_are_enabled() {
    [ "$SSA_NO_CHAT" = 0 ]
}
ask_chat() {
    printf 'chat from model:\n' >/dev/tty ||
        die "need /dev/tty or set SSA_NO_CHAT=1; see README.md"
    action_body '^# chat$' | sanitize_output >/dev/tty ||
        die "cannot show chat"
    printf 'your reply: ' >/dev/tty ||
        die "need /dev/tty or set SSA_NO_CHAT=1; see README.md"
    ring_terminal
    read_user_line "need /dev/tty or set SSA_NO_CHAT=1; see README.md"
    if [ -z "$USER_REPLY" ]; then
        USER_REPLY='The user sent no text.'
    fi
    printf '%s\n' "$USER_REPLY" | append_user_text
}
read_user_line() {
    IFS= read -r USER_REPLY </dev/tty || die "$1"
}
first_action_line() {
    print_model_reply | grep -E \
        '^# (write file:|edit file:|chat$)' |
        head -n 1 |
        grep .  # head succeeds on empty input; this fails then
}
record_format_error() {
    if [ $# -gt 0 ]; then
        note "format error: $(printf '%s\n' "$1" | head -n 1)"
        ACTION_OUTPUT="Format error: $*
"
    else
        note "format error"
        ACTION_OUTPUT="Format error: ${REPLY_SPEC}
"
    fi
    ACTION_EXIT=1
    show_action_output
    save_turn_output
    printf '%s' "$ACTION_OUTPUT" | append_user_text
}
show_action_output() {
    if [ -n "$ACTION_OUTPUT" ]; then
        printf '%s' "$ACTION_OUTPUT"
    fi
}
save_turn_output() {
    # shellcheck disable=SC2086
    UPDATED=$(printf '%s' "$ACTION_OUTPUT" |
        jq $JQ_BINARY_FLAG -Rs \
            --argjson code "$ACTION_EXIT" \
            --slurpfile log "$LOG_FILE" \
            '. as $raw | $log[0]
             | .turns[-1].output = $raw
             | .turns[-1].exit_code = $code') ||
        die "cannot update log"
    commit_log || die "cannot update log"
}
action_body() {
    print_model_reply | sed -n "/$1/,\$p" | sed '1d'
}
print_model_reply() {
    # shellcheck disable=SC2086
    jq $JQ_BINARY_FLAG -rj '.turns[-1].reply' "$LOG_FILE"
}
sanitize_output() {
    # Carriage return can overwrite the line; show as \r.
    CR_AS_SLASH_R="s/$(printf '\r')/\\\\r/g"
    # ESC starts ANSI/CSI sequences; show as \e.
    ESC_AS_SLASH_E="s/$(printf '\033')/\\\\e/g"
    # Other non-print bytes (keep tab); show as ?.
    NONPRINT_AS_QUESTION="s/[^[:print:]$(printf '\t')]/?/g"
    sed -e "$CR_AS_SLASH_R" |
        sed -e "$ESC_AS_SLASH_E" |
        sed -e "$NONPRINT_AS_QUESTION"
}
ring_terminal() {
    printf '\a' >/dev/tty || die "need /dev/tty; see README.md"
}
append_user_text() {
    # shellcheck disable=SC2086
    UPDATED=$(jq $JQ_BINARY_FLAG -Rs --slurpfile log "$LOG_FILE" \
        '. as $text | $log[0]
         | .messages += [{role:"user", content:$text}]') ||
        die "cannot update log"
    commit_log || die "cannot update log"
}
finish_agent_loop() {
    case $LOOP_STATUS in
        done)
            set_log_status "done"
            print_log_path
            printf 'done: after %s model prompts\n' \
                "$PROMPT_COUNTER" >&2
            exit 0 ;;
        hit\ max)
            set_log_status "hit max"
            print_log_path
            printf 'hit max: stopped after SSA_MAX_MODEL_PROMPTS (%s)\n' \
                "$SSA_MAX_MODEL_PROMPTS" >&2
            exit 1 ;;
        *) die "unknown loop status $LOOP_STATUS" ;;
    esac
}
note() {
    if [ "$SSA_VERBOSE" = 0 ]; then return; fi
    printf 'ssa: %s\n' "$*" >&2
}

die() {
    printf '%s\n' "$*" >&2
    set_log_status "die: $*"
    print_log_path
    if [ -n "${PID:-}" ]; then
        kill -USR1 "$PID" 2>/dev/null
    else
        printf 'PID not set; cannot signal parent process\n' >&2
    fi
    exit 1
}
set_log_status() {
    if [ -z "${LOG_FILE:-}" ] || [ ! -f "$LOG_FILE" ]; then
        return 0
    fi
    try_save_log --arg status "$1" '.status = $status' || return 0
}
try_save_log() {
    # shellcheck disable=SC2086
    UPDATED=$(jq $JQ_BINARY_FLAG "$@" "$LOG_FILE") || return 1
    commit_log
}
commit_log() {
    printf '%s\n' "$UPDATED" >"$LOG_FILE" || return 1
}
print_log_path() {
    if [ -n "${LOG_FILE:-}" ] && [ -f "$LOG_FILE" ]; then
        printf 'log file: %s\n' "$LOG_FILE" >&2
    fi
}
main "$@"
